+            PSpec(S_GLOW, 8f, 18f, 14f, 34f, 0.12f, 0.35f, 0.50f, 16f)
+        ),
+        backWeights = floatArrayOf(0.70f, 0.30f),
+        frontWeights = floatArrayOf(0.40f, 0.60f),
+        colors = arrayOf(Color(0xFFFF8A2B), Color(0xFFFFB347), Color(0xFFFF5A1F), Color(0xFFFFD27A)),
