+                if (entry == null || entry.size < 0L || entry.size > MAX_MANIFEST_BYTES) {
+                    null
+                } else {
+                    parseNativeManifest(decodeUtf8(zip.getInputStream(entry).use { it.readBytes() }))
+                }
+            }
+        } catch (_: Exception) {
+            null
+        }
