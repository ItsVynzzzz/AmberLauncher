+// =============================================================================
+// PENAMPIL SCREENSHOT LAYAR PENUH
+// =============================================================================
+
+/**
+ * Penampil screenshot layar penuh. Gambar ditampilkan utuh (tidak dipotong) di seluruh layar dan
+ * bisa digeser ke kiri/kanan antar-screenshot. Kontrol (nomor, tutup, panah) melayang di sudut
+ * supaya tidak mengurangi ukuran gambar.
+ */
+@Composable
+internal fun ModGalleryViewer(
+    gallery: List<ModrinthGalleryItem>,
+    initialUrl: String,
+    onClose: () -> Unit
+) {
+    // Bila daftar sudah tidak ada (pop up detail ditutup), tetap tampilkan gambar yang dibuka
+    val shots = if (gallery.any { it.url == initialUrl }) gallery else listOf(ModrinthGalleryItem(url = initialUrl))
+    val startIndex = shots.indexOfFirst { it.url == initialUrl }.coerceAtLeast(0)
+    val pagerState = rememberPagerState(initialPage = startIndex) { shots.size }
+    val scope = rememberCoroutineScope()
+    val current = pagerState.currentPage
+
+    AmberOverlay(
+        onDismiss = onClose,
+        dismissOnScrimTap = false,
+        scrimAlpha = 0.95f
+    ) {
+        HorizontalPager(
+            state = pagerState,
+            modifier = Modifier.fillMaxSize(),
+            pageSpacing = 12.dp
+        ) { page ->
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .padding(8.dp),
+                contentAlignment = Alignment.Center
+            ) {
+                NuxNetworkImage(
+                    model = shots[page].url,
+                    contentDescription = shots[page].title ?: "Pratinjau gambar",
+                    modifier = Modifier.fillMaxSize(),
+                    shape = RoundedCornerShape(14.dp),
+                    contentScale = ContentScale.Fit,
+                    maxSidePx = 1600,
+                    showSpinner = true
+                )
+            }
+        }
+
+        // Atas kiri: nomor screenshot (dan judulnya bila ada)
+        val caption = shots[current].title?.takeIf { it.isNotBlank() }
+        Row(
+            modifier = Modifier
+                .align(Alignment.TopStart)
+                .padding(12.dp)
+                .height(40.dp)
+                .widthIn(max = 280.dp)
+                .clip(CircleShape)
+                .background(Color.Black.copy(alpha = 0.55f), CircleShape)
+                .border(1.dp, AmberUi.Border, CircleShape)
+                .padding(horizontal = 14.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Text(
+                text = "${current + 1} / ${shots.size}",
+                color = AmberUi.Text,
+                fontWeight = FontWeight.Bold,
+                fontSize = 13.sp,
+                maxLines = 1
+            )
+            if (caption != null) {
+                Spacer(modifier = Modifier.width(10.dp))
+                Text(
+                    text = caption,
+                    color = AmberUi.TextDim,
+                    fontSize = 12.sp,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis
+                )
+            }
+        }
+
+        // Atas kanan: tutup
+        Box(
+            modifier = Modifier
+                .align(Alignment.TopEnd)
+                .padding(12.dp)
+                .size(40.dp)
+                .clip(CircleShape)
+                .background(Color.Black.copy(alpha = 0.55f), CircleShape)
+                .border(1.dp, AmberUi.Border, CircleShape)
+                .clickable { onClose() },
+            contentAlignment = Alignment.Center
+        ) {
+            Icon(
+                imageVector = Icons.Outlined.Close,
+                contentDescription = "Tutup",
+                tint = AmberUi.Text,
+                modifier = Modifier.size(20.dp)
+            )
+        }
+
+        // Panah kiri/kanan (hanya bila ada lebih dari satu screenshot)
+        if (shots.size > 1) {
+            GalleryArrow(
+                modifier = Modifier
+                    .align(Alignment.CenterStart)
+                    .padding(start = 12.dp),
+                flipped = true,
+                enabled = current > 0,
+                onClick = { scope.launch { pagerState.animateScrollToPage(current - 1) } }
+            )
+            GalleryArrow(
+                modifier = Modifier
+                    .align(Alignment.CenterEnd)
+                    .padding(end = 12.dp),
+                flipped = false,
+                enabled = current < shots.size - 1,
+                onClick = { scope.launch { pagerState.animateScrollToPage(current + 1) } }
+            )
+        }
+    }
+}
+
+@Composable
+private fun GalleryArrow(
+    modifier: Modifier,
+    flipped: Boolean,
+    enabled: Boolean,
+    onClick: () -> Unit
+) {
+    Box(
+        modifier = modifier
+            .size(44.dp)
+            .alpha(if (enabled) 1f else 0.3f)
+            .clip(CircleShape)
+            .background(Color.Black.copy(alpha = 0.55f), CircleShape)
+            .border(1.dp, AmberUi.Border, CircleShape)
+            .clickable(enabled = enabled) { onClick() },
+        contentAlignment = Alignment.Center
+    ) {
+        Icon(
+            imageVector = Icons.Outlined.ChevronRight,
+            contentDescription = null,
+            tint = AmberUi.Text,
+            modifier = Modifier
+                .size(26.dp)
+                .rotate(if (flipped) 180f else 0f)
+        )
+    }
+}
