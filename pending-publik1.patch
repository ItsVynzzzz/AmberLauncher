+            throw ModpackIncompatibleException(
+                "Modpack ini membutuhkan ${otherLoader.second}, sedangkan AmberLauncher saat ini hanya mendukung Fabric."
+            )
+        }
+        if (needsFabric && !instance.loader.equals("fabric", ignoreCase = true)) {
+            throw ModpackIncompatibleException(
