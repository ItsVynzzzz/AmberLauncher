+    /// AmberLauncher macro buttons (touch/amber_macro.rs): the launcher's definitions are read from
+    /// `amber-macros.json` (next to `horizon-touch.json`) again whenever the file changed.
+    fn android_macro_reload(&mut self) {
+        let path = std::path::Path::new(horizon_client::touch::amber_macro::FILE);
+        let stamp = std::fs::metadata(path).and_then(|m| m.modified()).ok();
+        let macros = &mut self.pad.touch.macros;
+        if macros.stamp == stamp && (stamp.is_some() || !macros.has_defs()) {
+            return;
+        }
+        macros.stamp = stamp;
+        macros.load(&std::fs::read_to_string(path).unwrap_or_default());
+    }
+
+    fn android_macro_press(&mut self, id: &str, down: bool) {
+        if down {
+            self.android_macro_reload();
+        }
+        let mut out = Vec::new();
+        self.pad
+            .touch
+            .macros
+            .press(id, down, Instant::now(), &mut out);
+        self.android_macro_apply(out);
+    }
+
+    /// Runs macros forward; they only play while a world is being played with the window in front.
+    fn android_macro_tick(&mut self) {
+        if self.pad.touch.macros.is_idle() {
+            return;
+        }
+        let live = self.title.is_none()
+            && self.screen == Screen::Playing
+            && !self.pause
+            && !self.pad_in_menu()
+            && self.focused;
+        let mut out = Vec::new();
+        self.pad.touch.macros.tick(Instant::now(), live, &mut out);
+        self.android_macro_apply(out);
+    }
+
+    fn android_macro_apply(&mut self, actions: Vec<horizon_client::touch::amber_macro::Action>) {
+        use horizon_client::touch::amber_macro::Action;
+        for action in actions {
+            match action {
+                Action::Down(token) => self.android_custom_token_edge(&token, true),
+                Action::Up(token) => self.android_custom_token_edge(&token, false),
+                Action::Scroll(token) => self.android_custom_token_tap(&token),
+                Action::Say(text) => {
+                    if self.title.is_none() && self.screen == Screen::Playing && !self.pause {
+                        self.handle_chat_input(&text);
+                    }
+                }
+            }
+        }
     }
 
