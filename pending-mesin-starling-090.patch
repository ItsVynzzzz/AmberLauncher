-+// Sync offsets the button steps through, in milliseconds added to the playback position: a positive
-+// offset shows each line earlier (useful when the phone's audio runs behind its clock, as it does on
-+// Bluetooth).
-+pub const OFFSETS_MS: [i32; 7] = [0, 250, 500, 1000, -1000, -500, -250];
