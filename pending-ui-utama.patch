+private val HOME_NAV_ITEMS = listOf(
+    Triple("home", "Home", Icons.Outlined.Home),
+    Triple("mods", "Mod", Icons.Outlined.FileDownload),
+    Triple("accounts", "Akun", Icons.Outlined.Person),
