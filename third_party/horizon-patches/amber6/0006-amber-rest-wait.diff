+    /// AmberLauncher: a slow phone (few workers) can show the title, and a frame can ask for the world's
+    /// resources, before the background loader has set them. Wait for the loader instead of ending the game with a
+    /// panic; the log names the caller. A loader that ended without setting them is still the panic it was.
+    #[cold]
+    #[track_caller]
+    fn wait_for_rest(&self) -> &WorldRest {
+        let caller = std::panic::Location::caller();
+        if std::thread::current().name() != Some("world-rest-loader") {
+            log::warn!("Amber: world resources asked for at {caller} before the loader finished; waiting for it");
+            while self.rest.get().is_none()
+                && REST_LOADERS_RUNNING.load(std::sync::atomic::Ordering::SeqCst) > 0
+            {
+                std::thread::sleep(std::time::Duration::from_millis(5));
+            }
+        }
         self.rest
             .get()
             .expect("world resources joined before entry")
