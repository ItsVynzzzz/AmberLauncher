++//! AmberLauncher hand-off. The Amber app writes `amber-launch.json` into the engine home and starts
++//! this activity. The engine then installs the game when it is missing and plays at once with the
++//! account Amber chose, so the player never has to press anything on this launcher screen.
++//!
++//! {"version":1,"type":"offline"|"microsoft","name":"...","uuid":"...","access_token":"...","xuid":"..."}
++//!
++//! The file is read once and deleted at once; it is refused when it is older than two minutes.
++use std::{
++    io::Write,
++    os::unix::fs::OpenOptionsExt,
++    path::{Path, PathBuf},
++    time::{Duration, SystemTime},
++};
++
++const FILE: &str = "amber-launch.json";
++const MAX_AGE: Duration = Duration::from_secs(120);
++
++/// What Amber asked for.
++pub(super) struct Request {
++    pub name: String,
++    pub uuid: String,
++    pub token: String,
++    pub xuid: String,
++    /// A Microsoft session; otherwise `name` plays offline.
++    pub microsoft: bool,
++}
++
++/// The request waiting in `home`, if any. The file is deleted whatever it holds.
++pub(super) fn take(home: &Path) -> Option<Request> {
++    let path = home.join(FILE);
++    let modified = std::fs::metadata(&path).ok()?.modified().ok();
++    let text = std::fs::read_to_string(&path);
++    let _ = std::fs::remove_file(&path);
++    let fresh = modified
++        .and_then(|m| SystemTime::now().duration_since(m).ok())
++        .is_none_or(|age| age <= MAX_AGE);
++    if !fresh {
++        log::warn!("Amber hand-off ignored: {FILE} is too old.");
++        return None;
++    }
++    let parsed = text
++        .ok()
++        .and_then(|t| serde_json::from_str::<serde_json::Value>(&t).ok());
++    let value = match parsed {
++        Some(value) => value,
++        None => {
++            log::warn!("Amber hand-off ignored: {FILE} is not valid JSON.");
++            return None;
++        }
++    };
++    let field = |key: &str| {
++        value
++            .get(key)
++            .and_then(|v| v.as_str())
++            .unwrap_or("")
++            .to_owned()
++    };
++    Some(Request {
++        name: field("name"),
++        uuid: field("uuid"),
++        token: field("access_token"),
++        xuid: field("xuid"),
++        microsoft: field("type") == "microsoft",
++    })
++}
++
++/// Write the Microsoft session for the game: owner-only, in a fresh file the game deletes when it
++/// reads it (the game refuses a session file older than two minutes, so this runs at Play time).
++pub(super) fn write_session(dir: &Path, request: &Request) -> Result<PathBuf, String> {
++    let xuid = if request.xuid.is_empty() {
++        serde_json::Value::Null
++    } else {
++        serde_json::Value::String(request.xuid.clone())
++    };
++    let body = serde_json::json!({
++        "name": request.name,
++        "uuid": request.uuid,
++        "access_token": request.token,
++        "user_type": "msa",
++        "xuid": xuid,
++    })
++    .to_string();
++    // The game's own parser decides whether the account is usable.
++    horizon_client::auth::AuthSession::parse(&body)
++        .map_err(|e| format!("The Amber account cannot be used: {e}"))?;
++    std::fs::create_dir_all(dir).map_err(|e| e.to_string())?;
++    // Leftovers of an earlier start that never reached the game.
++    if let Ok(entries) = std::fs::read_dir(dir) {
++        for entry in entries.flatten() {
++            if entry
++                .file_name()
++                .to_string_lossy()
++                .starts_with("session-amber-")
++            {
++                let _ = std::fs::remove_file(entry.path());
++            }
++        }
++    }
++    let nanos = SystemTime::now()
++        .duration_since(SystemTime::UNIX_EPOCH)
++        .map_or(0, |d| d.as_nanos());
++    let path = dir.join(format!("session-amber-{}-{nanos}.json", std::process::id()));
++    let mut options = std::fs::OpenOptions::new();
++    options.write(true).create_new(true);
++    options.mode(0o600);
++    let mut file = options.open(&path).map_err(|e| e.to_string())?;
++    file.write_all(body.as_bytes()).map_err(|e| e.to_string())?;
++    Ok(path)
++}
