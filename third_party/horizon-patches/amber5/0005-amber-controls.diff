+
+/// `GameActivity.nativeAmberToken` (AmberLauncher): a key or a mouse button of Amber's on-screen controls by the game's
+/// own token (`key.keyboard.w`, `key.mouse.left`, `mouse.scroll.up`), called on the UI thread.
+#[unsafe(no_mangle)]
+extern "system" fn Java_dev_horizon_android_GameActivity_nativeAmberToken(
+    mut env: jni::JNIEnv,
+    _class: jni::objects::JClass,
+    token: jni::objects::JString,
+    down: jni::sys::jboolean,
+) {
+    if token.is_null() {
+        return;
+    }
+    let Ok(name) = env.get_string(&token) else {
+        return;
+    };
+    horizon_client::amber_input::push(horizon_client::amber_input::Event::Token {
+        name: String::from(name),
+        down: down != 0,
+    });
+}
+
+/// `GameActivity.nativeAmberLook`: the view's turn in pixels from Amber's look layer, called on the UI thread.
+#[unsafe(no_mangle)]
+extern "system" fn Java_dev_horizon_android_GameActivity_nativeAmberLook(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    dx: f32,
+    dy: f32,
+) {
+    horizon_client::amber_input::push(horizon_client::amber_input::Event::Look { x: dx, y: dy });
+}
+
+/// `GameActivity.nativeAmberState`: what the screen was at the game's last frame (amber_input::ALIVE, MENU, CAPTURED).
+#[unsafe(no_mangle)]
+extern "system" fn Java_dev_horizon_android_GameActivity_nativeAmberState(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+) -> i32 {
+    horizon_client::amber_input::state() as i32
+}
