+/// AmberLauncher: horizontal center (0..1) of the control being edited, written by the drawing so the touch code
+/// docks the inspector on the same side. `0x3F00_0000` is `0.5f32`.
+static INSPECTOR_SELECTED_X: std::sync::atomic::AtomicU32 =
+    std::sync::atomic::AtomicU32::new(0x3F00_0000);
+
+/// AmberLauncher: the inspector panel `(dw, dh, dx, dy)`, docked to the side opposite the selected control (like
+/// Amber's control editor) so the control being edited stays visible. Shared by drawing and touch.
+fn inspector_rect(w: f32, h: f32) -> (f32, f32, f32, f32) {
+    let sel_x = f32::from_bits(INSPECTOR_SELECTED_X.load(std::sync::atomic::Ordering::Relaxed));
+    let dw = (w * 0.52).clamp(350.0, 640.0);
+    let dh = (h - 12.0).clamp(256.0, 384.0);
+    let dx = if sel_x >= 0.5 {
+        8.0
+    } else {
+        (w - dw - 8.0).max(0.0)
+    };
+    (dw, dh, dx, (h - dh) * 0.5)
+}
