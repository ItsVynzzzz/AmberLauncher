+            )
+        }
+
+        val packMc = deps.get("minecraft")?.takeIf { it.isJsonPrimitive }?.asString
+        if (!packMc.isNullOrBlank() && instance.mcVersion.isNotBlank() && packMc != instance.mcVersion) {
+            throw ModpackIncompatibleException(
