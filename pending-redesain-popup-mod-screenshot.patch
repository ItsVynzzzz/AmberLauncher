+// =============================================================================
+// POP UP DETAIL PROYEK (Modrinth / CurseForge) + PENAMPIL SCREENSHOT
+// =============================================================================
+
+private val PopupShape = RoundedCornerShape(28.dp)
+private val PopupFill = Color(0xFF18171C)
+private val TypePurple = Color(0xFFC084FC)
+private val TypeBlue = Color(0xFF6CB6FF)
+private val TypeAmber = Color(0xFFFFC857)
+
+private fun popupTypeColor(projectType: String): Color = when (projectType) {
+    "mod" -> AmberUi.AccentSoft
+    "modpack" -> TypePurple
+    "resourcepack" -> TypeBlue
+    else -> TypeAmber
+}
+
+private fun popupCompact(number: Long): String = when {
+    number >= 1_000_000 -> DecimalFormat("#,##0.#").format(number / 1_000_000.0) + "M"
+    number >= 1_000 -> DecimalFormat("#,##0.#").format(number / 1_000.0) + "K"
+    else -> number.toString()
+}
+
+/**
+ * Pop up detail proyek: kartu kecil di tengah layar (bukan halaman penuh).
+ *
+ * Layar lebar: kiri kartu identitas (ikon, nama, penulis, jenis, unduhan, versi dipilih) dengan
+ * tombol Pasang yang selalu terlihat di bawahnya; kanan tab Ringkasan / Versi yang digulir.
+ * Layar sempit: kepala di atas, tab, isi yang digulir, lalu tombol Pasang di dasar kartu.
+ * Ketuk area gelap di luar kartu untuk menutup (kecuali saat sedang memasang).
+ */
+@Composable
+internal fun ModDetailDialog(
+    hit: ModrinthSearchHit,
+    project: ModrinthProject?,
+    versions: List<ModrinthVersion>,
+    selectedVersion: ModrinthVersion?,
+    isLoading: Boolean,
+    isInstalling: Boolean,
+    progressText: String,
+    isInstalled: Boolean,
+    tab: String,
+    instance: Instance?,
+    onTab: (String) -> Unit,
+    onPickVersion: (ModrinthVersion) -> Unit,
+    onOpenGallery: (String) -> Unit,
+    onInstall: () -> Unit,
+    onClose: () -> Unit
+) {
+    val bodyScroll = rememberScrollState()
+    LaunchedEffect(tab) { bodyScroll.scrollTo(0) }
+
+    val isModpack = hit.projectType == "modpack"
+    val ctaText = if (isModpack) "Pasang modpack" else "Pasang ke instance"
+
+    AmberOverlay(
+        onDismiss = { if (!isInstalling) onClose() },
+        dismissOnScrimTap = !isInstalling,
+        scrimAlpha = 0.66f
+    ) {
+        BoxWithConstraints(
+            modifier = Modifier
+                .align(Alignment.Center)
+                .widthIn(max = 800.dp)
+                .fillMaxWidth(0.94f)
+                .heightIn(max = 460.dp)
+                .fillMaxHeight(0.94f)
+                .clip(PopupShape)
+                .background(PopupFill, PopupShape)
+                .border(1.dp, AmberUi.BorderStrong, PopupShape)
+                // Ketukan di dalam kartu tidak ikut menutup pop up
+                .pointerInput(Unit) { detectTapGestures { } }
+        ) {
+            if (maxWidth < 520.dp) {
+                // ---------------- SEMPIT: satu kolom ----------------
+                Column(
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .padding(14.dp),
+                    verticalArrangement = Arrangement.spacedBy(10.dp)
+                ) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        ModIconBox(hit = hit, size = 52.dp, radius = 16.dp)
+                        Spacer(modifier = Modifier.width(12.dp))
+                        Column(modifier = Modifier.weight(1f)) {
+                            Text(
+                                text = hit.title,
+                                color = AmberUi.Text,
+                                fontWeight = FontWeight.Black,
+                                fontSize = 17.sp,
+                                lineHeight = 21.sp,
+                                maxLines = 2,
+                                overflow = TextOverflow.Ellipsis
+                            )
+                            Text(
+                                text = "oleh ${hit.author ?: "Komunitas"}",
+                                color = AmberUi.TextDim,
+                                fontSize = 12.sp,
+                                maxLines = 1,
+                                overflow = TextOverflow.Ellipsis
+                            )
+                        }
+                        Spacer(modifier = Modifier.width(8.dp))
+                        PopupClose(enabled = !isInstalling, onClick = onClose)
+                    }
+                    PopupTabs(
+                        tab = tab,
+                        versionCount = versions.size,
+                        onTab = onTab,
+                        modifier = Modifier.fillMaxWidth()
+                    )
+                    Column(
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxWidth()
+                            .verticalScroll(bodyScroll)
+                    ) {
+                        ModPopupBody(
+                            hit = hit,
+                            project = project,
+                            versions = versions,
+                            selectedVersion = selectedVersion,
+                            isLoading = isLoading,
+                            tab = tab,
+                            instance = instance,
+                            onPickVersion = onPickVersion,
+                            onOpenGallery = onOpenGallery
+                        )
+                    }
+                    InstallCta(
+                        text = ctaText,
+                        isInstalling = isInstalling,
+                        progressText = progressText,
+                        isInstalled = isInstalled,
+                        canInstall = versions.isNotEmpty(),
+                        onInstall = onInstall,
+                        modifier = Modifier.fillMaxWidth()
+                    )
+                }
+            } else {
+                // ---------------- LEBAR: identitas di kiri, isi di kanan ----------------
+                val leftWidth = (maxWidth * 0.34f).coerceIn(200.dp, 250.dp)
+                Row(
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .padding(14.dp),
+                    horizontalArrangement = Arrangement.spacedBy(14.dp)
+                ) {
+                    Column(
+                        modifier = Modifier
+                            .width(leftWidth)
+                            .fillMaxHeight(),
+                        verticalArrangement = Arrangement.spacedBy(10.dp)
+                    ) {
+                        IdentityCard(
+                            hit = hit,
+                            selectedVersion = selectedVersion.takeIf { !isInstalled },
+                            modifier = Modifier
+                                .weight(1f)
+                                .fillMaxWidth()
+                        )
+                        InstallCta(
+                            text = ctaText,
+                            isInstalling = isInstalling,
+                            progressText = progressText,
+                            isInstalled = isInstalled,
+                            canInstall = versions.isNotEmpty(),
+                            onInstall = onInstall,
+                            modifier = Modifier.fillMaxWidth()
+                        )
+                    }
+                    Column(
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxHeight()
+                    ) {
+                        Row(
+                            modifier = Modifier.fillMaxWidth(),
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            PopupTabs(
+                                tab = tab,
+                                versionCount = versions.size,
+                                onTab = onTab,
+                                modifier = Modifier.weight(1f)
+                            )
+                            Spacer(modifier = Modifier.width(8.dp))
+                            PopupClose(enabled = !isInstalling, onClick = onClose)
+                        }
+                        Spacer(modifier = Modifier.height(10.dp))
+                        Column(
+                            modifier = Modifier
+                                .weight(1f)
+                                .fillMaxWidth()
+                                .verticalScroll(bodyScroll)
+                        ) {
+                            ModPopupBody(
+                                hit = hit,
+                                project = project,
+                                versions = versions,
+                                selectedVersion = selectedVersion,
+                                isLoading = isLoading,
+                                tab = tab,
+                                instance = instance,
+                                onPickVersion = onPickVersion,
+                                onOpenGallery = onOpenGallery
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ModIconBox(hit: ModrinthSearchHit, size: Dp, radius: Dp) {
+    val shape = RoundedCornerShape(radius)
+    NuxNetworkImage(
+        model = hit.iconUrl,
+        contentDescription = hit.title,
+        modifier = Modifier
+            .size(size)
+            .border(1.dp, AmberUi.BorderStrong, shape),
+        fallbackInitials = hit.title.take(2).uppercase(),
+        shape = shape,
+        maxSidePx = 256
+    )
+}
+
+/** Tab Ringkasan / Versi berbentuk pil. */
+@Composable
+private fun PopupTabs(
+    tab: String,
+    versionCount: Int,
+    onTab: (String) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    Row(
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        AmberChoicePill(
+            text = "Ringkasan",
+            selected = tab == "overview",
+            onClick = { onTab("overview") }
+        )
+        AmberChoicePill(
+            text = "Versi ($versionCount)",
+            selected = tab == "versions",
+            onClick = { onTab("versions") }
+        )
+    }
+}
+
+@Composable
+private fun PopupClose(enabled: Boolean, onClick: () -> Unit) {
+    Box(
+        modifier = Modifier
+            .size(40.dp)
+            .alpha(if (enabled) 1f else 0.4f)
+            .clip(CircleShape)
+            .amberGlass(CircleShape)
+            .clickable(enabled = enabled) { onClick() },
+        contentAlignment = Alignment.Center
+    ) {
+        Icon(
+            imageVector = Icons.Outlined.Close,
+            contentDescription = "Tutup",
+            tint = AmberUi.Text,
+            modifier = Modifier.size(20.dp)
+        )
+    }
+}
+
+/** Jumlah unduhan: ikon kecil + angka ringkas (menggantikan emoji). */
+@Composable
+private fun DownloadsChip(count: Long) {
+    Row(
+        modifier = Modifier
+            .clip(CircleShape)
+            .background(Color.White.copy(alpha = 0.09f), CircleShape)
+            .padding(horizontal = 9.dp, vertical = 3.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Icon(
+            imageVector = Icons.Outlined.Download,
+            contentDescription = null,
+            tint = AmberUi.TextDim,
+            modifier = Modifier.size(12.dp)
+        )
+        Spacer(modifier = Modifier.width(4.dp))
+        Text(
+            text = popupCompact(count),
+            color = AmberUi.TextDim,
+            fontSize = 11.sp,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1
+        )
+    }
+}
+
+/** Kartu identitas di kiri: ikon besar, nama, penulis, jenis, unduhan, dan versi yang dipilih. */
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun IdentityCard(
+    hit: ModrinthSearchHit,
+    selectedVersion: ModrinthVersion?,
+    modifier: Modifier = Modifier
+) {
+    val shape = RoundedCornerShape(24.dp)
+    Column(
+        modifier = modifier
+            .clip(shape)
+            .background(
+                Brush.verticalGradient(
+                    listOf(
+                        AmberUi.Accent.copy(alpha = 0.36f),
+                        AmberUi.Accent.copy(alpha = 0.07f)
+                    )
+                ),
+                shape
+            )
+            .border(1.dp, AmberUi.AccentEdge.copy(alpha = 0.55f), shape)
+            .verticalScroll(rememberScrollState())
+            .padding(14.dp)
+    ) {
+        ModIconBox(hit = hit, size = 64.dp, radius = 20.dp)
+        Spacer(modifier = Modifier.height(10.dp))
+        Text(
+            text = hit.title,
+            color = AmberUi.Text,
+            fontWeight = FontWeight.Black,
+            fontSize = 19.sp,
+            lineHeight = 23.sp,
+            maxLines = 3,
+            overflow = TextOverflow.Ellipsis
+        )
+        Spacer(modifier = Modifier.height(2.dp))
+        Text(
+            text = "oleh ${hit.author ?: "Komunitas"}",
+            color = AmberUi.TextDim,
+            fontSize = 12.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis
+        )
+        Spacer(modifier = Modifier.height(10.dp))
+        FlowRow(
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            verticalArrangement = Arrangement.spacedBy(6.dp)
+        ) {
+            AmberTag(hit.projectType.uppercase(), color = popupTypeColor(hit.projectType))
+            DownloadsChip(hit.downloads)
+        }
+        if (selectedVersion != null) {
+            Spacer(modifier = Modifier.height(14.dp))
+            Text(
+                text = "Versi dipilih",
+                color = AmberUi.TextDim,
+                fontSize = 11.sp
+            )
+            Text(
+                text = selectedVersion.name.ifBlank { selectedVersion.versionNumber },
+                color = AmberUi.Text,
+                fontSize = 13.sp,
+                fontWeight = FontWeight.Bold,
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis
+            )
+        }
+    }
+}
+
+/** Tombol utama: Pasang / sedang memasang (progres) / sudah terpasang. */
+@Composable
+private fun InstallCta(
+    text: String,
+    isInstalling: Boolean,
+    progressText: String,
+    isInstalled: Boolean,
+    canInstall: Boolean,
+    onInstall: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    if (isInstalling) {
+        Row(
+            modifier = modifier
+                .defaultMinSize(minHeight = 46.dp)
+                .clip(CircleShape)
+                .background(AmberUi.Accent.copy(alpha = 0.28f), CircleShape)
+                .border(1.dp, AmberUi.AccentEdge, CircleShape)
+                .padding(horizontal = 14.dp, vertical = 6.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            AmberSpinner(
+                modifier = Modifier.size(18.dp),
+                color = AmberUi.AccentSoft,
+                strokeWidth = 2.dp
+            )
+            Spacer(modifier = Modifier.width(10.dp))
+            Text(
+                text = progressText.ifBlank { "Sedang mengunduh dan memasang..." },
+                color = AmberUi.Text,
+                fontWeight = FontWeight.SemiBold,
+                fontSize = 12.sp,
+                lineHeight = 15.sp,
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis
+            )
+        }
+    } else if (isInstalled) {
+        Row(
+            modifier = modifier
+                .height(46.dp)
+                .clip(CircleShape)
+                .background(AmberUi.AccentSoft.copy(alpha = 0.12f), CircleShape)
+                .border(1.dp, AmberUi.AccentSoft.copy(alpha = 0.5f), CircleShape),
+            horizontalArrangement = Arrangement.Center,
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Icon(
+                imageVector = Icons.Outlined.Check,
+                contentDescription = null,
+                tint = AmberUi.AccentSoft,
+                modifier = Modifier.size(18.dp)
+            )
+            Spacer(modifier = Modifier.width(8.dp))
+            Text(
+                text = "Sudah terpasang",
+                color = AmberUi.AccentSoft,
+                fontWeight = FontWeight.Bold,
+                fontSize = 14.sp,
+                maxLines = 1
+            )
+        }
+    } else {
+        AmberActionButton(
+            text = text,
+            onClick = onInstall,
+            icon = Icons.Outlined.Download,
+            enabled = canInstall,
+            height = 46.dp,
+            modifier = modifier
+        )
+    }
+}
+
+/** Isi tab (tanpa gulir; pemanggil yang menggulir). */
+@Composable
+private fun ModPopupBody(
+    hit: ModrinthSearchHit,
+    project: ModrinthProject?,
+    versions: List<ModrinthVersion>,
+    selectedVersion: ModrinthVersion?,
+    isLoading: Boolean,
+    tab: String,
+    instance: Instance?,
+    onPickVersion: (ModrinthVersion) -> Unit,
+    onOpenGallery: (String) -> Unit
+) {
+    Column(verticalArrangement = Arrangement.spacedBy(14.dp)) {
+        if (isLoading) {
+            Box(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(140.dp),
+                contentAlignment = Alignment.Center
+            ) {
+                AmberSpinner(color = AmberUi.AccentSoft, modifier = Modifier.size(28.dp))
+            }
+        } else if (tab == "overview") {
+            val gallery = project?.gallery ?: emptyList()
+            if (gallery.isNotEmpty()) {
+                Column {
+                    AmberPageLabel("Tangkapan layar")
+                    LazyRow(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.spacedBy(10.dp)
+                    ) {
+                        items(gallery) { shot ->
+                            ScreenshotThumb(shot = shot, onClick = { onOpenGallery(shot.url) })
+                        }
+                    }
+                }
+            }
+
+            Column {
+                AmberPageLabel("Deskripsi")
+                AmberPanel(padding = 14.dp) {
+                    Text(
+                        text = project?.description ?: hit.description ?: "Tidak ada ringkasan deskripsi.",
+                        color = AmberUi.Text.copy(alpha = 0.9f),
+                        fontSize = 13.sp,
+                        lineHeight = 19.sp
+                    )
+                }
+            }
+
+            val allLoaders = (project?.loaders ?: hit.categories ?: emptyList()).distinct()
+            if (allLoaders.isNotEmpty()) {
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .horizontalScroll(rememberScrollState()),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp)
+                ) {
+                    allLoaders.take(6).forEach { tag -> LoaderChip(tag.uppercase()) }
+                }
+            }
+        } else {
+            if (versions.isEmpty()) {
+                val warnShape = RoundedCornerShape(20.dp)
+                Column(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clip(warnShape)
+                        .background(AmberUi.Danger.copy(alpha = 0.12f), warnShape)
+                        .border(1.dp, AmberUi.Danger.copy(alpha = 0.45f), warnShape)
+                        .padding(14.dp)
+                ) {
+                    Text(
+                        text = "Tidak ada versi yang didukung",
+                        color = AmberUi.Danger,
+                        fontWeight = FontWeight.Bold,
+                        fontSize = 13.sp
+                    )
+                    Spacer(modifier = Modifier.height(4.dp))
+                    Text(
+                        text = "Proyek ini tidak punya rilis yang cocok dengan Minecraft ${instance?.mcVersion ?: ""} (${(instance?.loader ?: "vanilla").uppercase()}).",
+                        color = AmberUi.TextDim,
+                        fontSize = 12.sp,
+                        lineHeight = 17.sp
+                    )
+                }
+            } else {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    versions.forEach { ver ->
+                        VersionRow(
+                            ver = ver,
+                            picked = selectedVersion?.id == ver.id,
+                            onClick = { onPickVersion(ver) }
+                        )
+                    }
+                }
+            }
+        }
+
+        Text(
+            text = if (hit.projectType == "modpack") {
+                "Modpack diekstrak langsung ke instance (overrides, konfigurasi, dan manifest)."
+            } else {
+                "Dependensi wajib ikut terpasang otomatis."
+            },
+            color = AmberUi.TextDim,
+            fontSize = 11.sp,
+            lineHeight = 16.sp,
+            modifier = Modifier.padding(start = 4.dp, bottom = 4.dp)
+        )
+    }
+}
+
+/** Gambar mini screenshot 16:9; ketuk untuk membuka penampil layar penuh. */
+@Composable
+private fun ScreenshotThumb(shot: ModrinthGalleryItem, onClick: () -> Unit) {
+    val shape = RoundedCornerShape(16.dp)
+    Box(
+        modifier = Modifier
+            .height(96.dp)
+            .aspectRatio(16f / 9f)
+            .clip(shape)
+            .border(1.dp, AmberUi.BorderStrong, shape)
+            .clickable { onClick() }
+    ) {
+        NuxNetworkImage(
+            model = shot.url,
+            contentDescription = shot.title ?: "Screenshot",
+            modifier = Modifier.fillMaxSize(),
+            shape = shape,
+            maxSidePx = 480,
+            showSpinner = true
+        )
+        Box(
+            modifier = Modifier
+                .align(Alignment.BottomEnd)
+                .padding(6.dp)
+                .size(22.dp)
