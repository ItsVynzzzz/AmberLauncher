-+//! AmberLauncher: the input of Amber's own on-screen controls.
-+//!
-+//! Amber puts its controls (the same ones its Java games use) over the game and sends what they press here. While
-+//! `AMBER_CONTROLS` is set (the launcher writes it to horizon-args.txt) the engine's own touch controls, its hub button
-+//! and its pop-up menu are off (game/mobile_controls.rs); their code stays, for the Bedrock layout and the engine's own
-+//! Goy layout, to come back with the variable unset. The calls arrive on the UI thread (JNI, android_lib.rs); the game's
-+//! thread takes them once a frame and says what the screen is back through [`state`].
-+use std::collections::VecDeque;
-+use std::sync::atomic::{AtomicU32, Ordering};
-+use std::sync::{Mutex, OnceLock};
-+
-+/// One thing the controls did.
-+pub enum Event {
-+    /// A key or a mouse button by the game's own token (`key.keyboard.w`, `key.mouse.left`, `mouse.scroll.up`).
-+    Token { name: String, down: bool },
-+    /// The view's turn in pixels, as a grabbed mouse makes it.
-+    Look { x: f32, y: f32 },
-+}
-+
-+/// The game is running its frames.
-+pub const ALIVE: u32 = 1;
-+/// A menu, a screen over the world or the title is open: Amber's controls show their menu side and let the touches through.
-+pub const MENU: u32 = 2;
-+/// The pointer is captured: the view turns with the motion.
-+pub const CAPTURED: u32 = 4;
-+
-+const MAX_QUEUED: usize = 2048;
-+static QUEUE: Mutex<VecDeque<Event>> = Mutex::new(VecDeque::new());
-+static STATE: AtomicU32 = AtomicU32::new(0);
-+
-+/// Amber's controls are on.
-+pub fn active() -> bool {
-+    static ACTIVE: OnceLock<bool> = OnceLock::new();
-+    *ACTIVE.get_or_init(|| std::env::var_os("AMBER_CONTROLS").is_some())
-+}
-+
-+/// Queues `event` for the game's thread.
-+pub fn push(event: Event) {
-+    let Ok(mut queue) = QUEUE.lock() else {
-+        return;
-+    };
-+    if let Event::Look { x, y } = event {
-+        // A turn adds to the one waiting; a game that stopped taking input loses turns, never a key's release.
-+        if let Some(Event::Look { x: wx, y: wy }) = queue.back_mut() {
-+            *wx += x;
-+            *wy += y;
-+            return;
-+        }
-+        if queue.len() >= MAX_QUEUED {
-+            return;
-+        }
-+    }
-+    queue.push_back(event);
-+}
-+
-+/// What came in since the last call, oldest first.
-+pub fn drain() -> Vec<Event> {
-+    match QUEUE.lock() {
-+        Ok(mut queue) => queue.drain(..).collect(),
-+        Err(_) => Vec::new(),
-+    }
-+}
-+
-+/// The game's thread: what the screen is now (the bits above).
-+pub fn set_state(bits: u32) {
-+    STATE.store(bits, Ordering::Relaxed);
-+}
-+
-+/// The UI thread: what the screen was at the game's last frame.
-+pub fn state() -> u32 {
-+    STATE.load(Ordering::Relaxed)
-+}
