<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Starling memakai Vulkan; dibuat tidak wajib supaya Amber tetap terpasang di HP tanpa Vulkan (Java dan Horizon tidak butuh). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- Rekam layar bawaan: service foreground bertipe mediaProjection (+ mikrofon bila dipilih) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Pemasangan Forge: installer resmi berjalan di service foreground bertipe dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto-update: memasang APK pembaruan lewat PackageInstaller. Pembaruan berikutnya bisa tanpa konfirmasi di Android 12+ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- SDK Discord (opsional) menambahkan izin Bluetooth untuk fitur suaranya, yang tidak dipakai di sini. -->
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

    <application
        android:name=".NuxApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NuxLauncher"
        android:requestLegacyExternalStorage="true"
        android:allowNativeHeapPointerTagging="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alias: Open With Mod (.jar) -->
        <activity-alias
            android:name=".ImportModActivity"
            android:targetActivity=".MainActivity"
            android:label="AmberLauncher — Mod"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.jar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-java-archive" />
                <data android:mimeType="application/x-jar" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: Open With Modpack (.mrpack / .zip) -->
        <activity-alias
            android:name=".ImportModpackActivity"
            android:targetActivity=".MainActivity"
            android:label="AmberLauncher — Modpack"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mrpack" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: Open With Resource Pack (.zip) -->
        <activity-alias
            android:name=".ImportResourcepackActivity"
            android:targetActivity=".MainActivity"
            android:label="AmberLauncher — Resource Pack"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: Open With Shaderpack (.zip) -->
        <activity-alias
            android:name=".ImportShaderpackActivity"
            android:targetActivity=".MainActivity"
            android:label="AmberLauncher — Shaderpack"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.NuxLauncher" />

        <!--
            Mesin Rust (Horizon, MIT): NativeActivity yang memuat libhorizon_android.so. Pustakanya TIDAK ada di repo,
            dipasang saat build oleh scripts/fetch-horizon-engine.sh (lihat docs/rust-engine.md); tanpanya activity ini
            tidak pernah dibuka karena HorizonEngine.availability() menolaknya lebih dulu.
            Proses :horizon sendiri karena mesinnya memanggil process::exit saat selesai, dan itu tidak boleh ikut
            mematikan launcher. Nama kelas terikat pada fungsi JNI di pustaka native, jadi tidak boleh diganti.
        -->
        <activity
            android:name="dev.horizon.android.HorizonActivity"
            android:exported="false"
            android:process=":horizon"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|density|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/HorizonGameTheme">
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
        </activity>

        <!--
            Starling (mesin Rust kedua, MIT): GameActivity memuat libstarling_android.so (NativeActivity). Kelas Java-nya
            TIDAK ada di repo: dipasang saat build bersama pustakanya oleh scripts/fetch-horizon-engine.sh
            (AMBER_ENGINE=starling); tanpanya activity ini tidak pernah dibuka karena StarlingEngine.availability()
            menolaknya lebih dulu. Proses :starling sendiri (terpisah dari :horizon milik Horizon) karena mesinnya
            mengakhiri prosesnya saat selesai. Nama kelas terikat pada fungsi JNI di pustaka native: jangan diganti.
        -->
        <activity
            android:name="dev.horizon.android.GameActivity"
            android:exported="false"
            android:process=":starling"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:theme="@style/HorizonGameTheme"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender"
            tools:ignore="MissingClass">
            <meta-data
                android:name="android.app.lib_name"
                android:value="starling_android" />
            <!-- Titik masuk native (android_lib.rs): sama dengan manifest Starling. -->
            <meta-data
                android:name="android.app.func_name"
                android:value="starling_on_create" />
        </activity>
        <!-- Memulai ulang game di proses baru (mis. setelah penyiapan pertama): kelas ini menunggu proses game berakhir. -->
        <activity
            android:name="dev.horizon.android.LauncherActivity"
            android:exported="false"
            android:process=":launcher"
            android:taskAffinity="${applicationId}.launcher"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="MissingClass" />
        <!-- Laporan diagnostik Starling (setelah crash berulang atau dari menu mesin). -->
        <activity
            android:name="dev.horizon.android.DiagnosticsActivity"
            android:exported="false"
            android:process=":diagnostics"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:hardwareAccelerated="false"
            tools:ignore="MissingClass" />
        <!-- Menjaga Starling tetap di latar depan saat unduhan sumber daya atau penyiapan berjalan. -->
        <service
            android:name="dev.horizon.android.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="MissingClass" />

        <!-- Satu proses dengan GameActivity supaya perekam berbagi status dan mati bersama game -->
        <service
            android:name=".core.record.RecordService"
            android:exported="false"
            android:process=":game"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Proses :forge sendiri: hidup hanya selama installer Forge berjalan, lalu dimatikan (tanpa RAM tersisa) -->
        <service
            android:name=".core.forge.ForgeInstallService"
            android:exported="false"
            android:process=":forge"
            android:foregroundServiceType="dataSync" />

        <!-- Penjaga proses selama Minecraft diunduh (proses utama, bukan proses sendiri) -->
        <service
            android:name=".core.download.DownloadKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Amber Lyrics: membaca judul, artis, dan posisi lagu dari pemutar musik HP (sesi media) lalu menulisnya ke
            config/amber_lyrics/now_playing.json untuk mod lirik Starling. Izin "Akses notifikasi" harus diberikan
            pengguna sendiri; layanan ini tidak membaca isi notifikasi (onNotificationPosted tidak dipakai).
        -->
        <service
            android:name=".core.horizon.NowPlayingListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Proses :vkcheck sendiri: pengecekan dukungan Vulkan memuat driver grafis HP, dan driver yang bermasalah
            bisa menutup prosesnya. Dengan proses terpisah, yang mati hanya :vkcheck, bukan launcher. Hidup beberapa
            detik lalu mematikan dirinya sendiri.
        -->
        <service
            android:name=".core.vulkan.VulkanCheckService"
            android:exported="false"
            android:process=":vkcheck" />

        <activity
            android:name=".ui.activities.ErrorActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:theme="@style/Theme.NuxLauncher" />

        <!-- Hasil pemasangan pembaruan dari PackageInstaller (hanya sistem yang memegang PendingIntent-nya) -->
        <receiver
            android:name=".core.update.UpdateInstallReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <package android:name="com.fcl.plugin.mobileglues" />
        <package android:name="com.bzlzhh.plugin.ngg" />
        <package android:name="com.bzlzhh.plugin.ngg.angleless" />
        <package android:name="ru.zdevs.zarchiver" />
    </queries>

</manifest>
