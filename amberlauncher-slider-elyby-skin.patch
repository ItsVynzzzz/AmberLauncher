+            tmp.writeBytes(bytes)
+            tmp.renameTo(target) || run {
+                target.delete()
+                tmp.renameTo(target)
             }
+        } catch (_: IOException) {
+            false
+        } finally {
+            if (tmp.exists()) tmp.delete()
