+// -------------------------------------------------------------------- Modpack
+
+/** Berkas modpack sementara milik layar ini. [handedOff] = sudah diserahkan ke Home, jangan dihapus lagi. */
+private class CiPackHolder {
+    var file: File? = null
+    var handedOff = false
+}
+
+/** Modpack yang sudah disalin ke cache dan dibaca isinya. */
+private class CiPickedPack(val file: File, val displayName: String, val info: ModpackReader.Info)
+
+/** Batas ukuran berkas yang mau disalin; yang lebih besar jelas bukan modpack. */
+private const val CI_MAX_PACK_BYTES = 1024L * 1024L * 1024L
+
+/** Nama berkas dari penyedia berkas Android; cadangan: bagian akhir alamatnya. */
+private fun ciPickedName(context: Context, uri: Uri): String {
+    var name: String? = null
+    if (uri.scheme == "content") {
+        try {
+            context.contentResolver.query(uri, null, null, null, null)?.use { cursor ->
+                val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+                if (index != -1 && cursor.moveToFirst()) name = cursor.getString(index)
+            }
+        } catch (_: Exception) {
+        }
+    }
+    if (name.isNullOrBlank()) name = uri.lastPathSegment?.substringAfterLast('/')
+    return name?.takeIf { it.isNotBlank() } ?: "modpack"
+}
+
+/**
+ * Menyalin berkas pilihan ke cache lalu membaca isinya. [previous] (pilihan sebelumnya) dibuang lebih dulu.
+ * Melempar [ModpackReader.ReadException] (pesannya aman ditampilkan) bila bukan modpack yang bisa dipasang,
+ * atau galat berkas biasa bila penyalinan gagal.
+ */
+private fun ciReadPickedPack(context: Context, uri: Uri, previous: File?): CiPickedPack {
+    previous?.delete()
+    val dir = File(context.cacheDir, "modpack-import")
+    dir.deleteRecursively()
+    if (!dir.mkdirs() && !dir.isDirectory) throw IOException("Gagal menyiapkan folder sementara")
+
+    val displayName = ciPickedName(context, uri)
+    val file = File(dir, SafePaths.fileName(displayName))
+    try {
+        val input = context.contentResolver.openInputStream(uri) ?: throw IOException("Gagal membaca berkas")
+        input.use { source ->
+            file.outputStream().use { out ->
+                val buffer = ByteArray(64 * 1024)
+                var total = 0L
+                while (true) {
+                    val read = source.read(buffer)
+                    if (read < 0) break
+                    total += read
+                    if (total > CI_MAX_PACK_BYTES) {
+                        throw ModpackReader.ReadException("Berkas ini terlalu besar untuk sebuah modpack.")
+                    }
+                    out.write(buffer, 0, read)
+                }
+            }
+        }
+        return CiPickedPack(file, displayName, ModpackReader.read(file))
+    } catch (e: Exception) {
+        file.delete()
+        throw e
+    }
+}
