+          else
+            rm -f "$AAR"
+            echo "::warning title=SDK Discord tidak terunduh::Periksa Secrets SDK_TOKEN (masa berlaku dan akses ke repo amber-private-libs) dan berkas discord_partner_sdk.aar di repo itu. APK dibangun tanpa fitur Discord RPC."
+          fi
