++//! AmberLauncher macros: touch buttons that play a saved sequence of key, mouse and chat steps.
++//!
++//! The launcher writes `amber-macros.json` next to `horizon-touch.json` and gives each macro button the key
++//! token `amber.macro:<id>`. Everything Amber-specific lives in this file, so updating the engine to a newer
++//! Horizon Android never has to merge it; upstream files only carry the few lines that connect it
++//! (`touch.rs`, `touch/custom.rs`, `touch_ui.rs`, `game/android_input.rs`).
++//!
++//! This module is plain state and time: it never touches the game. `press` and `tick` return `Action`s and
++//! the game (`android_input.rs`) carries them out, so the whole thing is tested without a device.
++use serde::Deserialize;
++use std::collections::HashMap;
++use std::sync::Arc;
++use std::time::{Duration, Instant};
++
++pub const TOKEN_PREFIX: &str = "amber.macro:";
++pub const FILE: &str = "amber-macros.json";
++
++const MAX_STEPS: usize = 64;
++const MAX_ROUNDS: u32 = 99;
++const MAX_MS: u64 = 30_000;
++const MAX_JITTER: u32 = 50;
++/// How long a Tap presses for.
++const TAP_MS: u64 = 35;
++
++/// The macro id in a button token, or `None` for any other token.
++pub fn token_id(token: &str) -> Option<&str> {
++    token.strip_prefix(TOKEN_PREFIX).filter(|id| !id.is_empty())
++}
++
++#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq, Eq)]
++#[serde(rename_all = "snake_case")]
++pub enum Mode {
++    /// One run per press (repeated `repeat` times); another press while it runs stops it.
++    #[default]
++    Once,
++    /// Runs until the finger lifts.
++    Hold,
++    /// Runs until the button is pressed again.
++    Toggle,
++}
++
++#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
++#[serde(tag = "op", rename_all = "snake_case")]
++pub enum Step {
++    /// Press and release (a key, a mouse button or an `action:` token).
++    Tap {
++        key: String,
++    },
++    Down {
++        key: String,
++    },
++    Up {
++        key: String,
++    },
++    /// Press, keep it down for `ms`, release.
++    Hold {
++        key: String,
++        ms: u64,
++    },
++    Wait {
++        ms: u64,
++    },
++    /// Chat or, when it starts with `/`, a command.
++    Type {
++        text: String,
++    },
++    Scroll {
++        up: bool,
++    },
++}
++
++#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
++pub struct Def {
++    #[serde(default)]
++    pub mode: Mode,
++    /// Rounds in `Once` mode (at least 1); the other modes loop until stopped.
++    #[serde(default)]
++    pub repeat: u32,
++    #[serde(default)]
++    pub loop_delay_ms: u64,
++    /// Random spread on every wait and hold, in percent (0..=50).
++    #[serde(default)]
++    pub jitter: u32,
++    /// Pause after each step.
++    #[serde(default = "default_gap")]
++    pub gap_ms: u64,
++    /// Shortest pause between two rounds.
++    #[serde(default = "default_min_loop")]
++    pub min_loop_ms: u64,
++    #[serde(default)]
++    pub steps: Vec<Step>,
++}
++
++fn default_gap() -> u64 {
++    10
++}
++
++fn default_min_loop() -> u64 {
++    30
++}
++
++#[derive(Deserialize)]
++struct FileData {
++    #[serde(default)]
++    macros: HashMap<String, Def>,
++}
++
++/// What the game has to do for a macro.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub enum Action {
++    Down(String),
++    Up(String),
++    /// A mouse wheel notch (`mouse.scroll.up` / `mouse.scroll.down`).
++    Scroll(String),
++    Say(String),
++}
++
++enum Phase {
++    /// Play `steps[step]` at `wake`.
++    Exec,
++    /// Let go of this token at `wake`.
++    Release(String),
++    /// Move on to the next step (or round) at `wake`.
++    Gap,
++}
++
++struct Run {
++    id: String,
++    def: Arc<Def>,
++    round: u32,
++    step: usize,
++    phase: Phase,
++    wake: Instant,
++    held: Vec<String>,
++}
++
++#[derive(Default)]
++pub struct Macros {
++    defs: HashMap<String, Arc<Def>>,
++    runs: Vec<Run>,
++    seed: u32,
++    /// Modification time of the file `defs` came from; `None` when there was no file.
++    pub stamp: Option<std::time::SystemTime>,
++}
++
++impl Macros {
++    /// Replaces the definitions with the ones in `text` (the file's contents; empty or broken text clears them).
++    /// Steps with a token the engine does not know are dropped, and nothing here may press another macro.
++    pub fn load(&mut self, text: &str) {
++        self.defs.clear();
++        let Ok(data) = serde_json::from_str::<FileData>(text) else {
++            return;
++        };
++        for (id, mut def) in data.macros {
++            def.steps.retain(valid_step);
++            def.steps.truncate(MAX_STEPS);
++            for step in &mut def.steps {
++                match step {
++                    Step::Wait { ms } | Step::Hold { ms, .. } => *ms = (*ms).min(MAX_MS),
++                    _ => {}
++                }
++            }
++            def.repeat = def.repeat.min(MAX_ROUNDS);
++            def.jitter = def.jitter.min(MAX_JITTER);
++            def.loop_delay_ms = def.loop_delay_ms.min(MAX_MS);
++            def.gap_ms = def.gap_ms.min(MAX_MS);
++            def.min_loop_ms = def.min_loop_ms.min(MAX_MS);
++            if !def.steps.is_empty() && !id.is_empty() {
++                self.defs.insert(id, Arc::new(def));
++            }
++        }
++    }
++
++    pub fn has_defs(&self) -> bool {
++        !self.defs.is_empty()
++    }
++
++    pub fn is_idle(&self) -> bool {
++        self.runs.is_empty()
++    }
++
++    pub fn running(&self, id: &str) -> bool {
++        self.runs.iter().any(|run| run.id == id)
++    }
++
++    /// True while the macro behind this button token plays (the button is drawn pressed).
++    pub fn running_token(&self, token: &str) -> bool {
++        !self.runs.is_empty() && token_id(token).is_some_and(|id| self.running(id))
++    }
++
++    /// A press (`down`) or release of a macro button.
++    pub fn press(&mut self, id: &str, down: bool, now: Instant, out: &mut Vec<Action>) {
++        let Some(def) = self.defs.get(id).cloned() else {
++            return;
++        };
++        if down {
++            if self.running(id) {
++                // Pressing again while it plays stops it.
++                self.stop(id, out);
++            } else {
++                self.runs.push(Run {
++                    id: id.to_owned(),
++                    def,
++                    round: 0,
++                    step: 0,
++                    phase: Phase::Exec,
++                    wake: now,
++                    held: Vec::new(),
++                });
++            }
++        } else if def.mode == Mode::Hold {
++            self.stop(id, out);
++        }
++    }
++
++    pub fn stop(&mut self, id: &str, out: &mut Vec<Action>) {
++        let mut i = 0;
++        while i < self.runs.len() {
++            if self.runs[i].id == id {
++                let run = self.runs.remove(i);
++                release_all(run, out);
++            } else {
++                i += 1;
++            }
++        }
++    }
++
++    pub fn stop_all(&mut self, out: &mut Vec<Action>) {
++        for run in std::mem::take(&mut self.runs) {
++            release_all(run, out);
++        }
++    }
++
++    /// Moves every running macro forward to `now`. `live` is false while no world is being played (a menu, the
++    /// pause screen, the title screen, another app): then every macro stops and lets go of what it holds.
++    pub fn tick(&mut self, now: Instant, live: bool, out: &mut Vec<Action>) {
++        if self.runs.is_empty() {
++            return;
++        }
++        if !live {
++            self.stop_all(out);
++            return;
++        }
++        let mut seed = self.seed;
++        if seed == 0 {
++            seed = 0x9E37_79B9 ^ (now.elapsed().subsec_nanos() | 1);
++        }
++        let mut runs = std::mem::take(&mut self.runs);
++        runs.retain_mut(|run| {
++            // A bound, so a macro made only of zero-length steps cannot spin forever inside one frame.
++            for _ in 0..64 {
++                if run.wake > now {
++                    return true;
++                }
++                if !advance(run, now, &mut seed, out) {
++                    release_all_ref(run, out);
++                    return false;
++                }
++            }
++            true
++        });
++        self.seed = seed;
++        self.runs = runs;
++    }
++}
++
++fn valid_step(step: &Step) -> bool {
++    let ok = |key: &str| {
++        !key.starts_with("amber.")
++            && key != "key.keyboard.unknown"
++            && !matches!(key, "mouse.virtual.toggle" | "mouse.look")
++            && !key.starts_with("mouse.scroll")
++            && super::CustomButton::valid_token(key)
++    };
++    match step {
++        Step::Tap { key } | Step::Down { key } | Step::Up { key } | Step::Hold { key, .. } => {
++            ok(key)
++        }
++        Step::Type { text } => !text.trim().is_empty(),
++        Step::Wait { .. } | Step::Scroll { .. } => true,
++    }
++}
++
++/// Plays one transition of `run`; false when the macro has finished.
++fn advance(run: &mut Run, now: Instant, seed: &mut u32, out: &mut Vec<Action>) -> bool {
++    let jitter = run.def.jitter;
++    match std::mem::replace(&mut run.phase, Phase::Gap) {
++        Phase::Release(key) => {
++            out.push(Action::Up(key.clone()));
++            run.held.retain(|held| *held != key);
++            run.wake = now;
++            true
++        }
++        Phase::Gap => {
++            run.step += 1;
++            let mut wait = jittered(run.def.gap_ms.max(1), jitter, seed);
++            if run.step >= run.def.steps.len() {
++                run.step = 0;
++                run.round += 1;
++                if run.def.mode == Mode::Once && run.round >= run.def.repeat.max(1) {
++                    return false;
++                }
++                let pause = run.def.loop_delay_ms.max(run.def.min_loop_ms);
++                wait += jittered(pause, jitter, seed);
++            }
++            run.phase = Phase::Exec;
++            run.wake = now + Duration::from_millis(wait);
++            true
++        }
++        Phase::Exec => {
++            let Some(step) = run.def.steps.get(run.step).cloned() else {
++                return false;
++            };
++            run.wake = now;
++            match step {
++                Step::Tap { key } => press_for(run, key, TAP_MS, now, seed, out),
++                Step::Hold { key, ms } => press_for(run, key, ms, now, seed, out),
++                Step::Down { key } => {
++                    if !run.held.contains(&key) {
++                        run.held.push(key.clone());
++                        out.push(Action::Down(key));
++                    }
++                }
++                Step::Up { key } => {
++                    run.held.retain(|held| *held != key);
++                    out.push(Action::Up(key));
++                }
++                Step::Wait { ms } => {
++                    run.wake = now + Duration::from_millis(jittered(ms, jitter, seed));
++                }
++                Step::Type { text } => out.push(Action::Say(text)),
++                Step::Scroll { up } => out.push(Action::Scroll(
++                    if up {
++                        "mouse.scroll.up"
++                    } else {
++                        "mouse.scroll.down"
++                    }
++                    .into(),
++                )),
++            }
++            true
++        }
++    }
++}
++
++fn press_for(
++    run: &mut Run,
++    key: String,
++    ms: u64,
++    now: Instant,
++    seed: &mut u32,
++    out: &mut Vec<Action>,
++) {
++    if !run.held.contains(&key) {
++        run.held.push(key.clone());
++    }
++    out.push(Action::Down(key.clone()));
++    run.phase = Phase::Release(key);
++    run.wake = now + Duration::from_millis(jittered(ms, run.def.jitter, seed));
++}
++
++/// Everything the macro still holds is let go (a key may never be left stuck down).
++fn release_all(mut run: Run, out: &mut Vec<Action>) {
++    release_all_ref(&mut run, out);
++}
++
++fn release_all_ref(run: &mut Run, out: &mut Vec<Action>) {
++    for key in run.held.drain(..) {
++        out.push(Action::Up(key));
++    }
++}
++
++/// `ms` plus or minus up to `percent` percent at random; never below 1 ms.
++fn jittered(ms: u64, percent: u32, seed: &mut u32) -> u64 {
++    if percent == 0 || ms <= 1 {
++        return ms;
++    }
++    // xorshift32: plenty for human-looking timing.
++    let mut x = *seed;
++    x ^= x << 13;
++    x ^= x >> 17;
++    x ^= x << 5;
++    *seed = x;
++    let unit = f64::from(x) / f64::from(u32::MAX) * 2.0 - 1.0;
++    let spread = f64::from(percent.min(MAX_JITTER)) / 100.0;
++    ((ms as f64 * (1.0 + unit * spread)) as u64).max(1)
++}
