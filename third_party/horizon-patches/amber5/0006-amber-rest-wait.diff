+/// AmberLauncher: how many world-resource loader threads are running (`Resources::wait_for_rest` waits for them).
+static REST_LOADERS_RUNNING: std::sync::atomic::AtomicUsize =
+    std::sync::atomic::AtomicUsize::new(0);
+
+/// One count of `REST_LOADERS_RUNNING`, held by the loader thread: it ends when the thread returns, fails or panics.
+struct RestLoaderRunning;
+impl RestLoaderRunning {
+    fn start() -> Self {
+        REST_LOADERS_RUNNING.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        Self
+    }
+}
+impl Drop for RestLoaderRunning {
+    fn drop(&mut self) {
+        REST_LOADERS_RUNNING.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
+    }
+}
