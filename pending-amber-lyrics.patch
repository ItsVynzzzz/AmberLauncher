++// The lyrics box: the song's title for a few seconds when it changes, the line being sung, and the
++// next line dimmed. Nothing is drawn (and nothing is computed beyond a lock and a search) while no
++// song is playing.
++fn amber_lyrics_hud(
++    game: &mut crate::game::Game<'_>,
++    batch: &mut horizon_client::hud::HudBatch,
++    corners: &mut horizon_client::extras_hud::Corners,
++) {
++    use crate::game::amber_lyrics as m;
++    let _ = corners;
++    if !game.native_on(m::ID) {
++        return;
++    }
++    // The worker thread starts once; the config folder is asked only until it has.
++    m::ensure_started(|| crate::game::Game::native_config_dir().ok());
++    if game.player.is_none() {
++        return;
++    }
++    let settings = m::cached_settings(&|key| game.native_setting(m::ID, key));
++    let Some(frame) = m::frame(settings, m::now_ms()) else {
++        return;
++    };
++
++    let width = batch.width;
++    let height = batch.height;
++    let max_width = (width - 16.0).min(360.0).max(60.0) - 2.0 * m::PAD_X;
++    let text_width = |s: &str| game.native_text_width(s);
++
++    // (text, 0xRRGGBB, alpha 0..1): the title in the launcher's amber, the line in white, the next dimmed.
++    let mut rows: Vec<(String, u32, f32)> = Vec::new();
++    if let Some(toast) = &frame.toast {
++        rows.push((m::truncate(toast, max_width, &text_width), 0xFFC83D, frame.toast_alpha));
++    }
++    if let Some(main) = &frame.main {
++        for line in m::wrap(main, max_width, 2, &text_width) {
++            rows.push((line, 0xFFFFFF, frame.main_alpha));
++        }
++        if let Some(next) = &frame.next {
++            rows.push((m::truncate(next, max_width, &text_width), 0xB4B4B4, frame.main_alpha * 0.6));
++        }
++    }
++    if rows.is_empty() {
++        return;
++    }
++    let alpha = rows.iter().map(|r| r.2).fold(0.0_f32, f32::max);
++    if m::alpha_u8(alpha) == 0 {
++        return;
++    }
++
++    let widest = rows.iter().map(|r| text_width(&r.0)).fold(0.0_f32, f32::max);
++    let w = (widest + 2.0 * m::PAD_X).ceil();
++    let h = rows.len() as f32 * m::ROW_HEIGHT + 2.0 * m::PAD_Y - 2.0;
++    let (x, y) = m::box_origin(settings.position, width, height, w, h);
++
++    // A dark glass pill with a thin white outline, fading with the text.
++    let backdrop = (u32::from(m::alpha_u8(alpha * 0.45)) << 24) | 0x000000;
++    let outline = (u32::from(m::alpha_u8(alpha * 0.22)) << 24) | 0xFFFFFF;
++    game.native_fill(batch, [x, y, w, h], backdrop);
++    game.native_fill(batch, [x, y, w, 1.0], outline);
++    game.native_fill(batch, [x, y + h - 1.0, w, 1.0], outline);
++    game.native_fill(batch, [x, y + 1.0, 1.0, h - 2.0], outline);
++    game.native_fill(batch, [x + w - 1.0, y + 1.0, 1.0, h - 2.0], outline);
++
++    for (i, (text, rgb, a)) in rows.iter().enumerate() {
++        let a = m::alpha_u8(*a);
++        if a == 0 {
++            continue;
++        }
++        let tx = (x + (w - text_width(text)) / 2.0).floor();
++        let ty = y + m::PAD_Y + i as f32 * m::ROW_HEIGHT;
++        let color = horizon_client::hud::rgba((rgb >> 16) as u8, (rgb >> 8) as u8, *rgb as u8, a);
++        batch.text(&game.gui.atlas, text, tx, ty, color, true);
++    }
++}
