-+// ---------------------------------------------------------------------------------------------
-+// What is playing (now_playing.json)
-+// ---------------------------------------------------------------------------------------------
-+
-+#[derive(Clone, Debug, PartialEq)]
-+pub struct NowPlaying {
-+    pub title: String,
-+    pub artist: String,
-+    pub album: String,
-+    pub duration_ms: i64,
-+    pub position_ms: i64,
-+    pub playing: bool,
-+    pub updated_at_ms: i64,
-+}
