-+fn lookup(dir: &Path, track: &Track) -> Result<Option<Vec<Line>>, String> {
-+    let cache_dir = dir.join(CACHE_FOLDER);
-+    let cached = cache_dir.join(cache_name(&track.key));
-+    if let Some(text) = read_capped(&cached, MAX_LRC_BYTES as u64) {
-+        let lines = parse_lrc(&text);
-+        if !lines.is_empty() {
-+            return Ok(Some(lines));
-+        }
-+    }
-+    match lookup_online(track)? {
-+        Some(lrc) => {
-+            let lines = parse_lrc(&lrc);
-+            if lines.is_empty() {
-+                return Ok(None);
-+            }
-+            let _ = std::fs::create_dir_all(&cache_dir).and_then(|()| std::fs::write(&cached, lrc));
