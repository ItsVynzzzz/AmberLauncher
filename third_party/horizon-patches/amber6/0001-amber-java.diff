+package io.github.juanluci.starling;
+
+import java.io.File;
+
+/**
+ * AmberLauncher: semua komponen mesin (game, peluncur ulang, diagnostik) memakai subfolder "starling" di folder
+ * privat aplikasi, supaya data mesin tidak bercampur dengan data launcher dan semua komponen melihat folder yang sama.
+ */
+final class AmberFolders {
+    private AmberFolders() {}
+
+    static File files(File base) {
+        File dir = new File(base, "starling");
+        //noinspection ResultOfMethodCallIgnored
+        dir.mkdirs();
+        return dir;
+    }
+}
