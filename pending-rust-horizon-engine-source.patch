+# Mesin Rust (Horizon): dikompilasi dari sumber, hasilnya diterbitkan sebagai Release di repo ini.
+#
+# Salin berkas ini ke .github/workflows/build-horizon-engine.yml (sekali, lewat editor web GitHub: Add file > Create
+# new file), lalu jalankan dari tab Actions > "Bangun mesin Rust (Horizon)" > Run workflow. Semua logikanya ada di
+# scripts/build-horizon-engine.sh (bisa diperbarui lewat patch), jadi berkas ini tidak perlu diubah lagi.
+# Jalankan ulang hanya bila commit= di horizon-engine.properties diganti. Panduan: docs/rust-engine.md
+name: Bangun mesin Rust (Horizon)
+
+on:
+  workflow_dispatch:
+    inputs:
+      profile:
+        description: "release = penuh (ThinLTO, lambat, butuh banyak RAM). fast = tanpa LTO, lebih cepat dan hemat RAM (untuk mencoba)"
+        type: choice
+        options: [release, fast]
+        default: release
+      force:
+        description: Bangun ulang walau Release untuk commit ini sudah ada
+        type: boolean
+        default: false
+
+permissions:
+  contents: write
+
+concurrency:
+  group: horizon-engine
+  cancel-in-progress: false
+
+jobs:
+  engine:
+    name: Bangun mesin Rust
+    runs-on: ubuntu-24.04
