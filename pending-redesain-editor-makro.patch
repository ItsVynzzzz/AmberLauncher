+@Composable
+private fun MbExamplesSection(hasSteps: Boolean, onApply: (MacroTemplate) -> Unit) {
+    var pending by remember { mutableIntStateOf(-1) }
+
+    MbSectionTitle(
+        number = null,
+        title = "Contoh siap pakai",
