+    /// AmberLauncher: a slow phone (few workers) can show the title, and a frame can ask for the world's
+    /// resources, before the background loader has set them. Wait for the loader (as `join_world_rest` does
+    /// on entry) instead of ending the game with a panic. The first wait names the caller in the log, so the
+    /// frame that asks too early can be given its own `rest_ready` guard. A loader that ended without setting
+    /// them (it failed) is still the panic it was.
+    #[cold]
+    #[track_caller]
+    fn wait_for_rest(&self) -> &WorldRest {
+        let caller = std::panic::Location::caller();
+        let on_loader = std::thread::current().name() == Some("world-rest-loader");
+        if !on_loader {
+            let waited = Instant::now();
+            log::warn!(
+                "Amber: world resources asked for at {caller} before the loader finished; waiting for it"
+            );
+            while self.rest.get().is_none()
+                && REST_LOADERS_RUNNING.load(std::sync::atomic::Ordering::SeqCst) > 0
+            {
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            if self.rest.get().is_some() {
+                log::warn!(
+                    "Amber: world resources ready after waiting {} ms at {caller}",
+                    waited.elapsed().as_millis()
+                );
+            }
+        }
         self.rest
