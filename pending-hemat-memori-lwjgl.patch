+private val imageCacheHolder: Lazy<LruCache<String, ImageBitmap>> = lazy {
     val maxBytes = (Runtime.getRuntime().maxMemory() / 12L)
         .coerceIn(8L * 1024L * 1024L, 32L * 1024L * 1024L)
