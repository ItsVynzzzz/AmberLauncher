+        hasPrevious = ControlPresetManager.hasPrevious(dir),
+        missingBuiltins = ControlPresetManager.missingBuiltins(dir),
+        activeId = activeId,
+        editingId = ControlPresetManager.editingId(dir)
+    )
+}
