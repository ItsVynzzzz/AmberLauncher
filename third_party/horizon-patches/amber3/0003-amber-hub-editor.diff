+/// Horizontal center (0..1) of the control being edited, written by the drawing so the touch code docks the
+/// inspector on the same side. `0x3F00_0000` is `0.5f32`.
+static INSPECTOR_SELECTED_X: std::sync::atomic::AtomicU32 =
+    std::sync::atomic::AtomicU32::new(0x3F00_0000);
+
+/// Inspector panel `(dw, dh, dx, dy)`, docked to the side opposite the selected control (like AmberLauncher's
+/// control editor) so the control being edited is never covered. Shared by drawing and touch.
+fn inspector_rect(w: f32, h: f32) -> (f32, f32, f32, f32) {
+    let sel_x = f32::from_bits(INSPECTOR_SELECTED_X.load(std::sync::atomic::Ordering::Relaxed));
+    let dw = (w * 0.52).clamp(350.0, 640.0);
+    let dh = (h - 12.0).clamp(256.0, 384.0);
+    let dx = if sel_x >= 0.5 {
+        8.0
+    } else {
+        (w - dw - 8.0).max(0.0)
+    };
+    let dy = (h - dh) * 0.5;
+    (dw, dh, dx, dy)
+}
+
+/// Rail sidebar geometry shared by drawing and touch: `(compact, pitch, pill_w, pill_h, exit_h)`.
+/// Compact (short screens) drops the labels so the five tabs and the exit button never overlap.
+fn hub_rail_metrics(dh: f32) -> (bool, f32, f32, f32, f32) {
+    if dh < 330.0 {
+        (true, 32.0, 40.0, 28.0, 34.0)
+    } else {
+        (false, 52.0, 52.0, 32.0, 52.0)
+    }
+}
