+/**
+ * Tombol rekam layar. Waktu berjalan dihitung hanya selama menu terbuka (sekali per detik);
+ * saat menu tertutup tidak ada pekerjaan UI sama sekali dari fitur rekam.
+ */
+@Composable
+private fun RecordBar(onClick: () -> Unit) {
+    val st by ScreenRecorder.state.collectAsState()
+    var seconds by remember { mutableLongStateOf(0L) }
+    LaunchedEffect(st.recording, st.startedAt) {
+        while (st.recording) {
+            seconds = (SystemClock.elapsedRealtime() - st.startedAt) / 1000L
+            delay(1000L)
+        }
+    }
+    val rec = st.recording
+    val shape = RoundedCornerShape(14.dp)
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(46.dp)
+            .clip(shape)
+            .background(if (rec) Amber.DangerTint else Amber.Fill)
+            .border(1.dp, if (rec) Amber.Danger else Amber.Line, shape)
+            .amberTap(onClick)
+            .padding(horizontal = 14.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        AmberIcon(if (rec) "stop" else "record", 20.dp, if (rec) Amber.Danger else Amber.Text)
+        Spacer(modifier = Modifier.width(10.dp))
+        Text(
+            text = when {
+                !rec -> "Rekam layar"
+                st.paused -> "Dijeda"
+                else -> "Merekam"
+            },
+            color = if (rec) Amber.DangerSoft else Amber.Text,
+            fontSize = 13.sp,
+            fontWeight = FontWeight.Bold,
+            modifier = Modifier.weight(1f)
+        )
+        Text(
+            text = if (rec) "%02d:%02d".format(seconds / 60L, seconds % 60L) else "Ketuk untuk mulai",
+            color = if (rec) Amber.DangerSoft else Amber.TextDim,
+            fontSize = 11.5.sp,
+            maxLines = 1
+        )
+    }
+}
