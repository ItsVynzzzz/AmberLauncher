+/** Kartu kaca bersudut besar untuk satu kelompok pilihan. */
+@Composable
+private fun SectionCard(content: @Composable () -> Unit) {
+    val shape = RoundedCornerShape(24.dp)
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(shape)
+            .amberGlass(shape)
+            .padding(16.dp)
+    ) {
+        content()
+    }
+}
