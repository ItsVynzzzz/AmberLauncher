+                            onProgress("Mengunduh $fileName... $percent%")
+                        }
+                    }
+                }
+            )
+            verifyHashes(archive, file.hashes)
+            onProgress("Membaca arsip world...")
+            val names = WorldInstaller.install(
+                zipFile = archive,
+                savesDir = File(gameDir, "saves"),
