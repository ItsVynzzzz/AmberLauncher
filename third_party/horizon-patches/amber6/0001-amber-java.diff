 package io.github.juanluci.starling;
 
-/** Native game component; StarlingActivity keeps the existing Java/JNI bridge API. */
-public final class GameActivity extends StarlingActivity {}
+import android.content.Intent;
+import android.os.Bundle;
+import com.israadev.nuxlauncher.BuildConfig;
+import com.israadev.nuxlauncher.discord.DiscordPresence;
+import java.io.File;
+
+/**
+ * Native game component; StarlingActivity keeps the existing Java/JNI bridge API.
+ *
+ * Perubahan AmberLauncher: getFilesDir() dan getCacheDir() diarahkan ke subfolder "starling" (data mesin terpisah dari
+ * data launcher), dan Discord Rich Presence opsional yang diminta launcher lewat Intent.
+ */
+public final class GameActivity extends StarlingActivity {
+    /** Diisi launcher: true bila pemain menyalakan Discord Rich Presence. */
+    public static final String EXTRA_DISCORD_RPC = "amber_discord_rpc";
+    /** Versi Minecraft yang ditampilkan di Rich Presence. */
+    public static final String EXTRA_MC_VERSION = "amber_mc_version";
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        startDiscordPresence();
+    }
+
+    // singleTask: bila mesin masih berjalan di latar, membukanya lagi datang lewat sini, bukan onCreate.
+    @Override protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        setIntent(intent);
+        startDiscordPresence();
+    }
+
+    @Override protected void onDestroy() {
+        try {
+            if (BuildConfig.HAS_DISCORD_SDK) DiscordPresence.INSTANCE.stopBlocking(800L);
+        } catch (Throwable ignored) {
+            // Presence hanyalah pelengkap: apa pun yang terjadi, mesin harus tetap bisa ditutup.
+        }
+        super.onDestroy();
+    }
+
+    private void startDiscordPresence() {
+        try {
+            if (!BuildConfig.HAS_DISCORD_SDK) return;
+            Intent intent = getIntent();
+            boolean requested = intent != null && intent.getBooleanExtra(EXTRA_DISCORD_RPC, false);
+            String version = intent == null ? null : intent.getStringExtra(EXTRA_MC_VERSION);
+            DiscordPresence.INSTANCE.onEngineStart(this, requested, version == null ? "" : version);
+        } catch (Throwable ignored) {
+            // Gagal menyalakan presence tidak boleh mengganggu mesin.
+        }
+    }
+
+    // NativeActivity membaca getFilesDir() dan getCacheDir() saat dibuat, lalu mesin memakainya sebagai rumah datanya.
+    @Override public File getFilesDir() { return AmberFolders.files(super.getFilesDir()); }
+
+    @Override public File getCacheDir() { return AmberFolders.files(super.getCacheDir()); }
+}
