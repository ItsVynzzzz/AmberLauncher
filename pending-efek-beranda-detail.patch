+ */
+private fun DrawScope.drawMeteorScene(t: Float, w: Float, h: Float, d: Float, alphaScale: Float) {
+    val period = 19f
+    val cycle = (t / period).toInt()
+    val local = (t - cycle * period) - 6f
+    val duration = 1.15f
+    if (local < 0f || local > duration) return
+    val p = local / duration
