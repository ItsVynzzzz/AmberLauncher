index 0000000..46d2b47
--- /dev/null
+++ b/app/src/main/java/com/israadev/nuxlauncher/core/update/WhatsNew.kt
@@ -0,0 +1,62 @@
+package com.israadev.nuxlauncher.core.update
+
+import com.google.gson.JsonParser
+
+/**
+ * Catatan "Yang baru": butir-butir perubahan per bahasa. Tanpa ketergantungan Android, jadi bisa diuji di JVM.
+ *
+ * Datanya dibuat oleh scripts/release-notes.py dari berkas .txt di changelog/entries dan sampai ke aplikasi lewat dua jalan:
+ *  - berkas assets/whatsnew.json di dalam APK (catatan versi yang terpasang, dibaca layar Tentang dan dialog
+ *    setelah pembaruan);
+ *  - blok tersembunyi `<!-- amber-whatsnew:v1 ... -->` di isi Release GitHub (catatan versi baru, dibaca pop-up pembaruan).
+ * Keduanya berisi JSON yang sama: {"v":1,"version":"1.2.4","lang":{"id":[["new","teks"],...],"en":[...],...}}.
+ */
+object WhatsNew {
+    const val ASSET = "whatsnew.json"
+
+    enum class Kind { NEW, IMPROVED, FIXED }
+
+    class Item(val kind: Kind, val text: String)
+
+    class Notes(val version: String, private val byLang: Map<String, List<Item>>) {
+        /** Butir untuk [lang] (kode bahasa launcher); bahasa yang tak ada jatuh ke Inggris, lalu Indonesia. */
+        fun forLanguage(lang: String): List<Item> =
+            byLang[lang]?.takeIf { it.isNotEmpty() } ?: byLang["en"] ?: byLang["id"] ?: emptyList()
+
+        fun isEmpty(): Boolean = byLang.values.all { it.isEmpty() }
+    }
+
+    // Awalan "https://" pada blok membuat aplikasi lama menyaringnya dari pop-up pembaruan (lihat ReleaseParser).
+    private val BLOCK = Regex("<!--\\s*amber-whatsnew:v1\\s+\\S+\\s+(\\{.*?\\})\\s*-->", RegexOption.DOT_MATCHES_ALL)
+
+    /** Mengurai JSON catatan; null bila bentuknya tidak dikenal atau kosong. */
+    fun fromJson(json: String): Notes? {
+        return try {
+            val root = JsonParser.parseString(json).asJsonObject
+            if (root.get("v")?.asInt != 1) return null
+            val map = HashMap<String, List<Item>>()
+            for ((lang, list) in root.getAsJsonObject("lang").entrySet()) {
+                val items = ArrayList<Item>()
+                for (e in list.asJsonArray) {
+                    val pair = e.asJsonArray
+                    val text = pair[1].asString.trim()
+                    if (text.isNotEmpty()) items += Item(kindOf(pair[0].asString), text)
+                }
+                map[lang] = items
+            }
+            Notes(root.get("version")?.asString.orEmpty(), map).takeUnless { it.isEmpty() }
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    /** Mengambil catatan dari isi Release GitHub; null bila Release tidak membawa blok catatan (rilis lama). */
+    fun fromReleaseBody(body: String): Notes? =
+        BLOCK.find(body)?.groupValues?.get(1)?.let { fromJson(it) }
+
+    private fun kindOf(code: String): Kind = when (code) {
+        "new" -> Kind.NEW
+        "fix" -> Kind.FIXED
+        else -> Kind.IMPROVED
+    }
+}
diff --git a/app/src/main/java/com/israadev/nuxlauncher/core/update/WhatsNewStore.kt b/app/src/main/java/com/israadev/nuxlauncher/core/update/WhatsNewStore.kt
new file mode 100644
index 0000000..44b339d
--- /dev/null
+++ b/app/src/main/java/com/israadev/nuxlauncher/core/update/WhatsNewStore.kt
@@ -0,0 +1,80 @@
+package com.israadev.nuxlauncher.core.update
+
+import android.content.Context
+
+/**
+ * Catatan "Yang baru" untuk versi yang terpasang: dibaca dari assets/whatsnew.json (dibuat saat build oleh
+ * scripts/release-notes.py) dan ingatan versi mana yang sudah ditampilkan otomatis.
+ *
+ * Build tanpa berkas itu (mis. dibangun di komputer sendiri) tidak punya catatan: layar Tentang menampilkan
+ * keterangan kosong dan dialog setelah pembaruan tidak muncul.
+ */
+object WhatsNewStore {
+    private const val PREFS_NAME = "amber_launcher_prefs"
+    private const val KEY_SEEN = "whatsnew_seen_version"
+
+    @Volatile
+    private var loaded = false
+
+    @Volatile
+    private var cached: WhatsNew.Notes? = null
+
+    /** Catatan versi yang terpasang, atau null bila build ini tidak membawanya. Dibaca sekali lalu disimpan. */
+    fun bundled(context: Context): WhatsNew.Notes? {
+        if (loaded) return cached
+        synchronized(this) {
+            if (!loaded) {
+                cached = try {
+                    context.applicationContext.assets.open(WhatsNew.ASSET).bufferedReader(Charsets.UTF_8).use {
+                        WhatsNew.fromJson(it.readText())
+                    }
+                } catch (_: Throwable) {
+                    null
+                }
+                loaded = true
+            }
+        }
+        return cached
+    }
+
+    /**
+     * Catatan yang perlu muncul otomatis sekali setelah pembaruan, atau null. Tidak muncul pada pemasangan baru
+     * (belum ada yang "baru" bagi pengguna) dan tidak pada build uji (nama versinya memuat "-uji"), yang terbit
+     * tiap kali ada patch. Berat sedikit (membaca berkas), jadi panggil dari thread latar.
+     */
+    fun pendingAutoShow(context: Context): WhatsNew.Notes? {
+        val notes = bundled(context) ?: return null
+        val current = UpdateChecker.currentVersionName(context)
+        if (current.isEmpty() || current.contains("-uji")) return null
+        val seen = prefs(context)?.getString(KEY_SEEN, null)
+        if (seen == current) return null
+        if (seen == null && isFreshInstall(context)) {
+            markSeen(context)
+            return null
+        }
+        return notes
+    }
+
+    /** Menandai versi yang sedang terpasang sudah dilihat penggunanya. */
+    fun markSeen(context: Context) {
+        val current = UpdateChecker.currentVersionName(context)
+        if (current.isEmpty()) return
+        try {
+            prefs(context)?.edit()?.putString(KEY_SEEN, current)?.apply()
+        } catch (_: Throwable) {
+        }
+    }
+
+    private fun prefs(context: Context) = try {
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+    } catch (_: Throwable) {
+        null
+    }
+
+    private fun isFreshInstall(context: Context): Boolean = try {
+        val info = context.packageManager.getPackageInfo(context.packageName, 0)
+        info.firstInstallTime == info.lastUpdateTime
+    } catch (_: Throwable) {
+        false
+    }
+}
