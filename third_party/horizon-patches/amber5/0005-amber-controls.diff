+    /// AmberLauncher: what Amber's controls did since the last frame (horizon_client::amber_input), then what the screen is.
+    /// Keys and mouse buttons go the way the engine's own custom buttons send them, by token.
+    pub(super) fn amber_pump(&mut self) {
+        use horizon_client::amber_input::{self, Event};
+        let mut turned = false;
+        for event in amber_input::drain() {
+            match event {
+                Event::Token { name, down } => self.android_custom_token_edge(&name, down),
+                Event::Look { x, y } => turned |= self.amber_look(x, y),
+            }
+        }
+        // A key's press asks for the pointer grab (android_dispatch_custom_token), and `capture` drops what `agent_pointer`
+        // says: a turn that came with it still counts as a grabbed pointer's in this frame (apply_mouse_look).
+        if turned {
+            self.agent_pointer = true;
+        }
+        let mut state = amber_input::ALIVE;
+        if self.pad_in_menu() {
+            state |= amber_input::MENU;
+        }
+        if self.captured {
+            state |= amber_input::CAPTURED;
+        }
+        amber_input::set_state(state);
+    }
+
+    /// The view's turn from Amber's look layer, fed the way an agent's `mouse-move` is (agent.rs). A finger is no captured
+    /// mouse: on a phone in its touch input mode `capture` never grabs the pointer, and each call makes the mouse skip its
+    /// next motion, so asking for the grab before each turn (what this did first) threw every turn away. The turn is added to
+    /// the frame's motion and apply_mouse_look counts it as a grabbed pointer's in an active window. False when it is not
+    /// taken: a menu or a screen is open, or the world is being saved.
+    fn amber_look(&mut self, x: f32, y: f32) -> bool {
+        if self.pad_in_menu() || self.pending_save.is_some() {
+            return false;
+        }
+        let (x, y) = (f64::from(x), f64::from(y));
+        self.note_input(
+            super::input_trace::InputOrigin::User,
+            super::input_trace::TraceKind::Motion { x, y },
+        );
+        self.mouse.add_motion(x, y);
+        self.last_input = std::time::Instant::now();
+        true
+    }
