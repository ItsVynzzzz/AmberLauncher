diff --git a/docs/site/app.js b/docs/site/app.js
index a4e18b4..2822c41 100644
--- a/docs/site/app.js
+++ b/docs/site/app.js
@@ -221,145 +221,8 @@
     } catch (e) { /* abaikan */ }
   }
 
-  /* ---------- Demo kontrol ---------- */
-
-  function setupRig() {
-    var rig = $('rig');
-    var svg = $('scene');
-    if (!rig || !svg || !svg.setPointerCapture) return;
-
-    var joy = svg.querySelector('.joy');
-    var thumb = svg.querySelector('.thumb');
-    var far = svg.querySelector('.far');
-    var near = svg.querySelector('.near');
-    var world = $('world');
-    var VW = 324, CX = 52, CY = 98, R = 18;
-    var active = null;
-
-    function stopHint() { rig.classList.remove('hint'); }
-
-    function setPos(dx, dy) {
-      thumb.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
-      far.style.transform = 'translate(' + (-dx * 0.3) + 'px,0)';
-      near.style.transform = 'translate(' + (-dx * 0.7) + 'px,0)';
-    }
-
-    function move(e) {
-      var r = svg.getBoundingClientRect();
-      var k = VW / r.width;
-      var dx = (e.clientX - r.left) * k - CX;
-      var dy = (e.clientY - r.top) * k - CY;
-      var d = Math.sqrt(dx * dx + dy * dy);
-      if (d > R) { dx *= R / d; dy *= R / d; }
-      setPos(dx, dy);
-    }
-
-    function setBack(on) {
-      [thumb, far, near].forEach(function (n) { n.classList[on ? 'add' : 'remove']('back'); });
-    }
-
-    joy.addEventListener('touchstart', function (e) { e.preventDefault(); }, { passive: false });
-    joy.addEventListener('pointerdown', function (e) {
-      if (active !== null) return;
-      stopHint();
-      active = e.pointerId;
-      try { joy.setPointerCapture(e.pointerId); } catch (err) { /* abaikan */ }
-      setBack(false);
-      move(e);
-      e.preventDefault();
-    });
-    joy.addEventListener('pointermove', function (e) { if (e.pointerId === active) move(e); });
-    function release(e) {
-      if (e.pointerId !== active) return;
-      active = null;
-      setBack(true);
-      setPos(0, 0);
-    }
-    joy.addEventListener('pointerup', release);
-    joy.addEventListener('pointercancel', release);
-    joy.addEventListener('lostpointercapture', release);
-
-    function play(cls) {
-      world.classList.remove('hop', 'swing');
-      void world.getBoundingClientRect();
-      world.classList.add(cls);
-    }
-    world.addEventListener('animationend', function () { world.classList.remove('hop', 'swing'); });
-
-    all('#scene .pad').forEach(function (pad) {
-      var kind = pad.getAttribute('data-b');
-      function down(e) {
-        stopHint();
-        pad.classList.add('on');
-        if (kind === 'jump') play('hop');
-        else if (kind === 'attack') play('swing');
-        e.preventDefault();
-      }
-      function up() { pad.classList.remove('on'); }
-      pad.addEventListener('pointerdown', down);
-      pad.addEventListener('pointerup', up);
-      pad.addEventListener('pointerleave', up);
-      pad.addEventListener('pointercancel', up);
-    });
-
-    var slots = all('#scene .slot');
-    slots.forEach(function (slot) {
-      slot.addEventListener('pointerdown', function (e) {
-        slots.forEach(function (s) { s.classList.remove('sel'); });
-        slot.classList.add('sel');
-        e.preventDefault();
-      });
-    });
-  }
-
-  /* ---------- Screenshot (opsional) ----------
-     Berkas assets/shots/{home,mods,akun,game}.webp dipakai bila ada. Bila tidak ada, bagian itu
-     tidak ditampilkan dan hero tetap memakai demo kontrol. */
-
-  function probe(name, ok) {
-    var base = document.body.getAttribute('data-shots');
-    if (!base) return;
-    var im = new Image();
-    im.onload = function () { ok(im); };
-    im.src = base + name + '.webp';
-  }
-
-  function setupShots() {
-    var homeCap = document.body.getAttribute('data-shot-home') || '';
-    probe('home', function (im) {
-      var stage = $('stage'), rig = $('rig'), slot = $('rig-slot');
-      if (!stage || !rig || !slot) return;
-      var fig = document.createElement('figure');
-      fig.className = 'shot';
-      var frame = document.createElement('div');
-      frame.className = 'frame';
-      im.alt = homeCap;
-      frame.appendChild(im);
-      var cap = document.createElement('figcaption');
-      cap.textContent = homeCap;
-      fig.appendChild(frame);
-      fig.appendChild(cap);
-      slot.hidden = false;
-      slot.appendChild(rig);
-      stage.appendChild(fig);
-    });
-    var gallery = $('tampilan');
-    all('[data-shot]').forEach(function (fig) {
-      probe(fig.getAttribute('data-shot'), function (im) {
-        var img = fig.querySelector('img');
-        var cap = fig.querySelector('figcaption');
-        img.src = im.src;
-        img.alt = cap ? cap.textContent : '';
-        fig.hidden = false;
-        if (gallery) gallery.hidden = false;
-      });
-    });
-  }
-
   loadRelease();
   setupCopy();
-  setupRig();
-  setupShots();
   loadStars();
   setupReveal();
 })();
