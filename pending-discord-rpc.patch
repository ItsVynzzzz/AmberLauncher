+                echo '```'
+              } >> "$GITHUB_STEP_SUMMARY"
+              echo "::warning title=Discord RPC dinonaktifkan::Build dengan SDK Discord gagal; membangun ulang tanpa SDK. Lihat ringkasan run."
+              rm -rf app/build app/.cxx
+              AMBER_DISCORD=0 ./gradlew assembleRelease --stacktrace 2>&1 | tee "$RUNNER_TEMP/gradle.log"
+            else
