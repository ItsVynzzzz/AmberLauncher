+/** Satu baris versi: lingkaran pilihan, nama, "Versi x · MC y", dan label rilis/beta/alpha. */
+@Composable
+private fun VersionRow(
+    ver: ModrinthVersion,
+    picked: Boolean,
+    onClick: () -> Unit
+) {
+    val rowShape = RoundedCornerShape(20.dp)
+    val verColor = when (ver.versionType) {
+        "release" -> AmberUi.AccentSoft
+        "beta" -> TypeAmber
+        else -> AmberUi.Danger
+    }
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(rowShape)
+            .then(
+                if (picked) {
+                    Modifier
+                        .background(AmberUi.Accent.copy(alpha = 0.5f), rowShape)
+                        .border(1.dp, AmberUi.AccentEdge, rowShape)
+                } else {
+                    Modifier.amberGlass(rowShape)
+                }
+            )
+            .clickable { onClick() }
+            .padding(horizontal = 12.dp, vertical = 10.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Box(
+            modifier = Modifier
+                .size(20.dp)
+                .clip(CircleShape)
+                .background(if (picked) AmberUi.AccentSoft else Color.Transparent, CircleShape)
+                .border(
+                    1.5.dp,
+                    if (picked) AmberUi.AccentSoft else AmberUi.TextDim,
+                    CircleShape
+                ),
+            contentAlignment = Alignment.Center
+        ) {
+            if (picked) {
+                Icon(
+                    imageVector = Icons.Outlined.Check,
+                    contentDescription = null,
+                    tint = PopupFill,
+                    modifier = Modifier.size(13.dp)
+                )
+            }
+        }
+        Spacer(modifier = Modifier.width(12.dp))
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = ver.name.ifBlank { ver.versionNumber },
+                color = AmberUi.Text,
+                fontWeight = FontWeight.Bold,
+                fontSize = 13.sp,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis
+            )
+            Text(
+                text = "Versi ${ver.versionNumber} · MC ${ver.gameVersions.joinToString(", ")}",
+                color = AmberUi.TextDim,
+                fontSize = 11.sp,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis
+            )
+        }
+        Spacer(modifier = Modifier.width(8.dp))
+        AmberTag(ver.versionType.uppercase(), color = verColor)
+    }
+}
