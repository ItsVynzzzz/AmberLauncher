+    langBtn.addEventListener('click', () => applyLang(currentLang === 'en' ? 'id' : 'en'));
+
+    let savedLang = null;
+    try { savedLang = localStorage.getItem('amber-lang'); } catch (e) {}
+    applyLang(savedLang === 'id' || savedLang === 'en' ? savedLang : (navigator.language || '').toLowerCase().startsWith('id') ? 'id' : 'en');
+
+    loadLatestApkAssets();
+  </script>
 </body>
 </html>
