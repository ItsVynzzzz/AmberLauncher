-+// FNV-1a: a stable file name for a track key, with no extra crate.
-+pub fn cache_name(key: &str) -> String {
-+    let mut hash: u64 = 0xcbf29ce484222325;
-+    for b in key.as_bytes() {
-+        hash ^= u64::from(*b);
-+        hash = hash.wrapping_mul(0x100000001b3);
-+    }
-+    format!("{hash:016x}.lrc")
-+}
-+
-+fn read_capped(path: &Path, cap: u64) -> Option<String> {
-+    let meta = std::fs::metadata(path).ok()?;
-+    if !meta.is_file() || meta.len() > cap {
-+        return None;
-+    }
-+    std::fs::read_to_string(path).ok()
-+}
-+
-+// The synced lyrics LRCLIB's answer holds, if any.
-+pub fn synced_from_entry(entry: &serde_json::Value) -> Option<String> {
-+    if entry.get("instrumental").and_then(|x| x.as_bool()) == Some(true) {
-+        return None;
-+    }
-+    let lrc = entry.get("syncedLyrics")?.as_str()?;
-+    if lrc.trim().is_empty() || lrc.len() > MAX_LRC_BYTES {
-+        return None;
-+    }
-+    Some(lrc.to_owned())
-+}
-+
-+// Of a search's results, the synced lyrics of the entry whose length is closest to the song's.
-+pub fn best_search_result(results: &serde_json::Value, duration_secs: i64) -> Option<String> {
-+    let mut best: Option<(i64, String)> = None;
-+    for entry in results.as_array()? {
-+        let Some(lrc) = synced_from_entry(entry) else { continue };
-+        let length = entry.get("duration").and_then(|x| x.as_f64()).unwrap_or(0.0);
-+        let distance = if duration_secs > 0 && length > 0.0 {
-+            (length - duration_secs as f64).abs().round() as i64
-+        } else {
-+            0
-+        };
-+        // A song's other versions (live, a remix) are often minutes longer or shorter.
-+        if duration_secs > 0 && length > 0.0 && distance > 10 {
-+            continue;
-+        }
-+        if best.as_ref().is_none_or(|(d, _)| distance < *d) {
-+            best = Some((distance, lrc));
-+        }
-+    }
-+    best.map(|(_, lrc)| lrc)
-+}
