+            Text(
+                text = statusText,
+                color = statusColor,
+                fontSize = 12.sp,
+                lineHeight = 16.sp,
+                modifier = Modifier.padding(top = 2.dp)
+            )
+        }
+        Spacer(modifier = Modifier.width(12.dp))
+        NuxButton(
+            onClick = {
+                if (showsPrompt) UpdateManager.openPrompt() else UpdateManager.checkNow(context)
+            },
+            enabled = !checking,
+            backgroundColor = NuxColors.Yellow,
+            cornerRadius = 20.dp,
