@@ -0,0 +1,20 @@
+package com.israadev.nuxlauncher.starling
+
+/**
+ * Jalur dari kontrol Amber ke mesin Starling. Diisi oleh GameActivity milik Starling (dev.horizon.android, dari sumber
+ * Starling dan patch amber5/0005): kelas Java itu yang memegang fungsi native, jadi Kotlin di sini tidak pernah menyebut
+ * kelas yang baru ada setelah mesin dipasang dan build tanpa mesin tetap utuh.
+ */
+interface StarlingBridge {
+    /** Tombol keyboard atau mouse dengan token milik game (`key.keyboard.w`, `key.mouse.left`, `mouse.scroll.up`). */
+    fun token(name: String, down: Boolean)
+
+    /** Putaran kamera dalam piksel, seperti gerak mouse yang ditangkap. */
+    fun look(dx: Float, dy: Float)
+
+    /** Keadaan layar mesin pada frame terakhir: bit 1 = berjalan, 2 = menu/layar terbuka, 4 = penunjuk ditangkap. */
+    fun state(): Int
+
+    /** Menutup mesin. */
+    fun exit()
+}
diff --git a/app/src/main/java/com/israadev/nuxlauncher/starling/StarlingInput.kt b/app/src/main/java/com/israadev/nuxlauncher/starling/StarlingInput.kt
new file mode 100644
index 0000000..4747821
--- /dev/null
+++ b/app/src/main/java/com/israadev/nuxlauncher/starling/StarlingInput.kt
@@ -0,0 +1,51 @@
+package com.israadev.nuxlauncher.starling
+
+import com.israadev.nuxlauncher.core.horizon.RustTouchLayout
+import org.lwjgl.glfw.CallbackBridge
+
+/**
+ * Penerima input untuk kontrol Amber di proses :starling: apa yang ditekan kontrol (lewat [CallbackBridge], persis seperti
+ * di game Java) diteruskan ke mesin Starling lewat [StarlingBridge], dengan nama tombol milik game.
+ */
+internal object StarlingInput : CallbackBridge.InputSink {
+    @Volatile
+    var bridge: StarlingBridge? = null
+
+    override fun key(keycode: Int, isDown: Boolean) {
+        val token = RustTouchLayout.keyToken(keycode) ?: return
+        send(token, isDown)
+    }
+
+    override fun mouseButton(button: Int, isDown: Boolean) {
+        val token = when (button) {
+            0 -> "key.mouse.left"
+            1 -> "key.mouse.right"
+            2 -> "key.mouse.middle"
+            else -> return
+        }
+        send(token, isDown)
+    }
+
+    override fun cursorDelta(dx: Float, dy: Float) {
+        try {
+            bridge?.look(dx, dy)
+        } catch (_: Throwable) {
+            // Mesin sedang ditutup: putaran kamera terakhir tidak penting.
+        }
+    }
+
+    override fun scroll(xoffset: Double, yoffset: Double) {
+        when {
+            yoffset > 0.0 -> send("mouse.scroll.up", true)
+            yoffset < 0.0 -> send("mouse.scroll.down", true)
+        }
+    }
+
+    private fun send(token: String, down: Boolean) {
+        try {
+            bridge?.token(token, down)
+        } catch (_: Throwable) {
+            // Mesin sedang ditutup: tombol yang terlepas tidak perlu dilaporkan.
+        }
+    }
+}
