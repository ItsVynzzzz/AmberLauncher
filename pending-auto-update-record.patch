+        var rec: MediaRecorder? = null
+        var proj: MediaProjection? = null
+        var vd: VirtualDisplay? = null
+        var out: Output? = null
+        try {
+            val o = openOutput(ctx)
+            out = o
+
+            val r = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                MediaRecorder(ctx)
