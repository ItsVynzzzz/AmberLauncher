+/**
+ * Kolom isian satu baris. [searchIcon] menambah kaca pembesar di kiri; [onClear] menampilkan tombol
+ * hapus saat ada isi.
+ */
+@Composable
+private fun AiField(
+    value: String,
+    onChange: (String) -> Unit,
+    placeholder: String,
+    searchIcon: Boolean = false,
+    onClear: (() -> Unit)? = null
+) {
+    val shape = RoundedCornerShape(12.dp)
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(42.dp)
+            .clip(shape)
+            .background(Amber.Fill)
+            .border(1.dp, Amber.LineStrong, shape)
+            .padding(horizontal = 12.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        if (searchIcon) {
+            Box(
+                modifier = Modifier
+                    .size(16.dp)
+                    .drawBehind {
+                        val s = size.minDimension
+                        val sw = s * 0.12f
+                        drawCircle(
+                            color = Amber.TextDim,
+                            radius = s * 0.30f,
+                            center = Offset(s * 0.42f, s * 0.42f),
+                            style = Stroke(width = sw)
+                        )
+                        drawLine(
+                            color = Amber.TextDim,
+                            start = Offset(s * 0.64f, s * 0.64f),
+                            end = Offset(s * 0.90f, s * 0.90f),
+                            strokeWidth = sw,
+                            cap = StrokeCap.Round
+                        )
+                    }
+            )
+            Spacer(modifier = Modifier.width(8.dp))
+        }
+        BasicTextField(
+            value = value,
+            onValueChange = onChange,
+            singleLine = true,
+            textStyle = TextStyle(
+                color = Amber.Text,
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Medium
+            ),
+            cursorBrush = SolidColor(Amber.Yellow),
+            modifier = Modifier.weight(1f),
+            decorationBox = { inner ->
+                Box(contentAlignment = Alignment.CenterStart) {
+                    if (value.isEmpty()) {
+                        Text(
+                            text = placeholder,
+                            color = Amber.TextFaint,
+                            fontSize = 14.sp,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis
+                        )
+                    }
+                    inner()
+                }
+            }
+        )
+        if (onClear != null && value.isNotEmpty()) {
+            Box(
+                modifier = Modifier
+                    .size(28.dp)
+                    .clip(CircleShape)
+                    .amberTap(onClear),
+                contentAlignment = Alignment.Center
+            ) {
+                AmberIcon("close", 16.dp, Amber.TextDim)
+            }
+        }
+    }
+}
+
+/** Tanda centang kecil yang digambar langsung. */
+@Composable
+private fun AiCheck(color: Color, boxSize: Dp = 16.dp) {
+    Box(
+        modifier = Modifier
+            .size(boxSize)
+            .drawBehind {
+                val s = size.minDimension
+                val sw = s * 0.14f
+                drawLine(color, Offset(s * 0.20f, s * 0.54f), Offset(s * 0.42f, s * 0.76f), sw, StrokeCap.Round)
+                drawLine(color, Offset(s * 0.42f, s * 0.76f), Offset(s * 0.82f, s * 0.28f), sw, StrokeCap.Round)
+            }
+    )
+}
