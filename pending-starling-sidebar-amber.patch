++//! AmberLauncher: Amber's in-game menu (the "sidebar"), drawn by the engine itself.
++//!
++//! The launcher turns it on with `AMBER_SIDEBAR=1` in `horizon-args.txt` (patch amber5/0007). It replaces the
++//! control hub: no three-line button, no tabbed modal. Amber's MENU button (custom token `amber.menu`) opens a
++//! panel on the right of the screen. It reuses the hub's open flag (`TouchUi::floating_menu`), so the Back key,
++//! the modal input rules and the draw order stay as they were, and it answers with the hub's own
++//! `InGameMenuAction`s, so the game applies them with the code that already exists.
++//!
++//! The panel is drawn with the engine's own `Ui` and the active theme (the launcher already colors it like
++//! Amber): nothing is drawn by Android, no extra window, no extra GPU work.
++use crate::{
++    android_control_theme::{Face, Icon, ResolvedTheme, Ui, color},
++    android_control_ui::{InGameMenuAction, TouchUi},
++    hud::{HudAtlas, HudBatch, rgba},
++};
++use std::sync::OnceLock;
++use winit::{event::TouchPhase, keyboard::KeyCode};
++
++/// Whether the launcher asked for Amber's sidebar instead of the engine's control hub.
++pub fn active() -> bool {
++    static ACTIVE: OnceLock<bool> = OnceLock::new();
++    *ACTIVE.get_or_init(|| std::env::var_os("AMBER_SIDEBAR").is_some_and(|value| value == "1"))
++}
++
++/// "Instance · version" under the title, from `AMBER_INSTANCE` and `AMBER_MC_VERSION`.
++fn subtitle() -> &'static str {
++    static TEXT: OnceLock<String> = OnceLock::new();
++    TEXT.get_or_init(|| {
++        let name = std::env::var("AMBER_INSTANCE").unwrap_or_default();
++        let version = std::env::var("AMBER_MC_VERSION").unwrap_or_default();
++        match (name.is_empty(), version.is_empty()) {
++            (false, false) => format!("{name} \u{b7} {version}"),
++            (false, true) => name,
++            (true, false) => version,
++            (true, true) => String::new(),
++        }
++    })
++}
++
++/// The sliders of the panel.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub enum Slider {
++    Resolution,
++    Sensitivity,
++    ButtonScale,
++}
++
++#[derive(Clone, Copy, PartialEq, Eq)]
++enum Toggle {
++    Animations,
++    InvertY,
++    LeftHanded,
++    AutoJump,
++    Vibrate,
++}
++
++#[derive(Clone, Copy)]
++enum Row {
++    Quick,
++    Section(&'static str),
++    Slider(Slider),
++    Toggle(Toggle),
++    Keys(usize),
++}
++
++const ROWS: [Row; 14] = [
++    Row::Quick,
++    Row::Section("Tampilan"),
++    Row::Slider(Slider::Resolution),
++    Row::Toggle(Toggle::Animations),
++    Row::Section("Kontrol"),
++    Row::Slider(Slider::Sensitivity),
++    Row::Slider(Slider::ButtonScale),
++    Row::Toggle(Toggle::InvertY),
++    Row::Toggle(Toggle::LeftHanded),
++    Row::Toggle(Toggle::AutoJump),
++    Row::Toggle(Toggle::Vibrate),
++    Row::Section("Pintasan"),
++    Row::Keys(0),
++    Row::Keys(1),
++];
++
++/// Round buttons of the first row: icon and label (Keyboard, Pointer, Edit buttons, Log).
++const QUICK: [(Icon, &str); 4] = [
++    (Icon::Pencil, "Keyboard"),
++    (Icon::Crosshair, "Pointer"),
++    (Icon::Settings, "Edit tombol"),
++    (Icon::Terminal, "Log"),
++];
++
++const KEYS: [[(&str, KeyCode); 3]; 2] = [
++    [("F3", KeyCode::F3), ("F5", KeyCode::F5), ("Chat", KeyCode::KeyT)],
++    [("Buang", KeyCode::KeyQ), ("Tukar", KeyCode::KeyF), ("Jeda", KeyCode::Escape)],
++];
++
++const HEAD_H: f32 = 48.0;
++const FOOT_H: f32 = 56.0;
++
++fn row_h(row: &Row) -> f32 {
++    match row {
++        Row::Quick => 74.0,
++        Row::Section(_) => 26.0,
++        Row::Slider(_) => 46.0,
++        Row::Toggle(_) => 38.0,
++        Row::Keys(_) => 40.0,
++    }
++}
++
++fn content_h() -> f32 {
++    ROWS.iter().map(row_h).sum::<f32>() + 12.0
++}
++
++/// Where the panel is, in dp. `shift` slides it in from the right edge while it opens.
++struct Geo {
++    panel: [f32; 4],
++    close: [f32; 4],
++    view: [f32; 4],
++    exit: [f32; 4],
++}
++
++fn geo(w: f32, h: f32, shift: f32) -> Geo {
++    let pw = (w * 0.5).clamp(300.0, 340.0).min((w - 12.0).max(200.0));
++    let ph = (h - 12.0).max(200.0);
++    let px = w - pw - 6.0 + shift;
++    let py = 6.0;
++    Geo {
++        panel: [px, py, pw, ph],
++        close: [px + pw - 42.0, py + 10.0, 28.0, 28.0],
++        view: [px, py + HEAD_H, pw, ph - HEAD_H - FOOT_H],
++        exit: [px + 12.0, py + ph - FOOT_H + 8.0, pw - 24.0, FOOT_H - 16.0],
++    }
++}
++
++/// Calls `visit` with every row and its rectangle (dp), scrolled by `scroll`.
++fn walk(g: &Geo, scroll: f32, mut visit: impl FnMut(&Row, [f32; 4])) {
++    let mut y = g.view[1] + 6.0 - scroll;
++    for row in ROWS.iter() {
++        let h = row_h(row);
++        visit(row, [g.view[0] + 12.0, y, g.view[2] - 24.0, h - 4.0]);
++        y += h;
++    }
++}
++
++fn contains(r: [f32; 4], p: [f32; 2]) -> bool {
++    p[0] >= r[0] && p[0] <= r[0] + r[2] && p[1] >= r[1] && p[1] <= r[1] + r[3]
++}
++
++fn slider_bounds(which: Slider) -> (f32, f32) {
++    match which {
++        Slider::Resolution => (25.0, 100.0),
++        Slider::Sensitivity => (0.10, 3.00),
++        Slider::ButtonScale => (0.50, 2.00),
++    }
++}
++
++fn slider_value(which: Slider, s: &crate::android_controls::Settings) -> f32 {
++    match which {
++        Slider::Resolution => s.resolution_scale_percent as f32,
++        Slider::Sensitivity => s.sensitivity,
++        Slider::ButtonScale => s.button_scale,
++    }
++}
++
++fn slider_text(which: Slider, v: f32) -> String {
++    match which {
++        Slider::Resolution => format!("{:.0}%", v),
++        Slider::Sensitivity => format!("{:.2}", v),
++        Slider::ButtonScale => format!("{:.0}%", v * 100.0),
++    }
++}
++
++fn slider_label(which: Slider) -> &'static str {
++    match which {
++        Slider::Resolution => "Resolusi 3D",
++        Slider::Sensitivity => "Sensitivitas kamera",
++        Slider::ButtonScale => "Ukuran tombol",
++    }
++}
++
++/// The action for dragging `which` to `frac` (0..1) of its track, or `None` when the value does not change.
++fn slider_action(
++    which: Slider,
++    frac: f32,
++    s: &crate::android_controls::Settings,
++) -> Option<InGameMenuAction> {
++    let (lo, hi) = slider_bounds(which);
++    let raw = lo + frac.clamp(0.0, 1.0) * (hi - lo);
++    match which {
++        Slider::Resolution => {
++            let pct = ((raw / 5.0).round() * 5.0) as u32;
++            (pct != s.resolution_scale_percent).then_some(InGameMenuAction::SetResolutionScale(pct))
++        }
++        Slider::Sensitivity => {
++            let v = ((raw / 0.05).round() * 0.05).clamp(lo, hi);
++            ((v - s.sensitivity).abs() > 0.004).then_some(InGameMenuAction::SetTouchSensitivity(v))
++        }
++        Slider::ButtonScale => {
++            let v = ((raw / 0.05).round() * 0.05).clamp(lo, hi);
++            ((v - s.button_scale).abs() > 0.004).then_some(InGameMenuAction::SetButtonScale(v))
++        }
++    }
++}
++
++fn toggle_label(t: Toggle) -> &'static str {
++    match t {
++        Toggle::Animations => "Animasi game",
++        Toggle::InvertY => "Balik sumbu Y",
++        Toggle::LeftHanded => "Mode kidal",
++        Toggle::AutoJump => "Lompat otomatis",
++        Toggle::Vibrate => "Getar",
++    }
++}
++
++fn toggle_on(t: Toggle, s: &crate::android_controls::Settings) -> bool {
++    match t {
++        Toggle::Animations => !s.disable_game_animations,
++        Toggle::InvertY => s.invert_y,
++        Toggle::LeftHanded => s.left_handed,
++        Toggle::AutoJump => s.auto_jump,
++        Toggle::Vibrate => s.vibrate,
++    }
++}
++
++fn toggle_action(t: Toggle) -> InGameMenuAction {
++    match t {
++        Toggle::Animations => InGameMenuAction::ToggleGameAnimations,
++        Toggle::InvertY => InGameMenuAction::ToggleInvertY,
++        Toggle::LeftHanded => InGameMenuAction::ToggleLeftHanded,
++        Toggle::AutoJump => InGameMenuAction::ToggleAutoJump,
++        Toggle::Vibrate => InGameMenuAction::ToggleVibrate,
++    }
++}
++
++fn draw_switch(ui: &mut Ui<'_>, x: f32, y: f32, on: bool, t: &ResolvedTheme) {
++    let (tw, th) = (38.0, 22.0);
++    if on {
++        ui.rounded(x, y, tw, th, th / 2.0, t.accent);
