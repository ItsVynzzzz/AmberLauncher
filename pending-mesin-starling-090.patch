-+pub fn frame(settings: Settings, now: i64) -> Option<Frame> {
-+    let mut st = lock(&STATE);
-+    let np = st.np.clone()?;
-+    let mut out = Frame::default();
-+
-+    if settings.toast {
-+        if let Some(at) = st.toast_at {
-+            match toast_alpha(at.elapsed().as_secs_f32()) {
-+                Some(alpha) => {
-+                    let found = match st.lyrics {
-+                        Lyrics::Ready(_) => Some(true),
-+                        Lyrics::Missing => Some(false),
-+                        _ => None,
-+                    };
-+                    out.toast = Some(toast_text(&np, found));
-+                    out.toast_alpha = alpha;
-+                }
-+                None => st.toast_at = None,
-+            }
-+        }
-+    }
-+
-+    if is_live(&np, now) {
-+        let pos = position_ms(&np, now, settings.offset_ms);
-+        let mut shown: Option<(usize, String, Option<String>)> = None;
-+        if let Lyrics::Ready(lines) = &st.lyrics {
-+            if let Some(idx) = current_index(lines, pos) {
-+                if line_visible(lines, idx, pos) {
-+                    let next = if settings.next_line {
-+                        lines.get(idx + 1).map(|l| l.text.clone()).filter(|t| !t.is_empty())
-+                    } else {
-+                        None
-+                    };
-+                    shown = Some((idx, lines[idx].text.clone(), next));
-+                }
-+            }
-+        }
-+        match shown {
-+            Some((idx, text, next)) => {
-+                if st.shown_idx != Some(idx) {
-+                    st.shown_idx = Some(idx);
-+                    st.shown_at = Some(Instant::now());
-+                }
-+                let since = st.shown_at.map(|t| t.elapsed()).unwrap_or(FADE_IN);
-+                out.main_alpha = (since.as_secs_f32() / FADE_IN.as_secs_f32()).clamp(0.0, 1.0);
-+                out.main = Some(text);
-+                out.next = next;
-+            }
-+            None => st.shown_idx = None,
-+        }
-+    }
-+
-+    if out.main.is_none() && out.toast.is_none() {
-+        return None;
-+    }
-+    Some(out)
-+}
