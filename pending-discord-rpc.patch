+          # gagal, dibangun ulang tanpa SDK (AMBER_DISCORD=0) dan kesalahan pertamanya ditulis di ringkasan run.
+          if ! ./gradlew assembleRelease --stacktrace 2>&1 | tee "$RUNNER_TEMP/gradle.log"; then
+            if [ -f app/libs/discord_partner_sdk.aar ]; then
